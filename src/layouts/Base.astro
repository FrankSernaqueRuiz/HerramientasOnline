---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES, ALL_TOOLS } from '../data/tools';

interface Props {
  title: string;
  description: string;
  topAd?: boolean;
  keywords?: string;
}

const { title, description, topAd = false, keywords = '' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://tudominio.com';
const canonical = new URL(Astro.url.pathname, Astro.site);
const pagePath = Astro.url.pathname;
const isHome = pagePath === '/' || pagePath === '';

// Find current tool info for individual tool pages
const currentTool = ALL_TOOLS.find((t) => t.href === pagePath);

// JSON-LD: WebSite schema (shown on all pages, enables sitelinks search box)
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'HerramientasOnline',
  url: siteUrl,
  description: 'Herramientas web gratuitas que funcionan en tu navegador: calculadoras, generadores, convertidores y más.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/?q={search_term_string}`
    },
    'query-input': 'required name=search_term_string'
  }
};

// JSON-LD: SiteNavigationElement (helps Google generate sitelinks to individual tools)
const navElements = ALL_TOOLS.filter(t => t.status === 'ready').map((tool) => ({
  '@type': 'SiteNavigationElement',
  name: tool.name,
  description: tool.desc,
  url: `${siteUrl}${tool.href}`
}));

const navigationSchema = {
  '@context': 'https://schema.org',
  '@graph': navElements
};

// JSON-LD: WebApplication schema for individual tool pages
const toolSchema = currentTool ? {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: currentTool.name,
  description: currentTool.desc,
  url: `${siteUrl}${currentTool.href}`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  },
  browserRequirements: 'Requires JavaScript. Works in Chrome, Firefox, Safari, Edge.',
  isPartOf: {
    '@type': 'WebSite',
    name: 'HerramientasOnline',
    url: siteUrl
  }
} : null;

// JSON-LD: BreadcrumbList for tool pages
const currentCategory = currentTool
  ? CATEGORIES.find(c => c.id === currentTool.category)
  : null;

const breadcrumbSchema = currentTool && currentCategory ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: siteUrl
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: currentCategory.name,
      item: `${siteUrl}/categoria/${currentCategory.id}`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: currentTool.name,
      item: `${siteUrl}${currentTool.href}`
    }
  ]
} : null;

// Auto-generate keywords for tool pages from tool name/desc if none explicitly passed
const autoKeywords = (() => {
  if (keywords) return keywords;
  if (currentTool) {
    const parts = [
      currentTool.name,
      'herramienta online',
      'gratis',
      'en línea',
      currentTool.desc.split('.')[0]
    ];
    if (currentCategory) parts.push(currentCategory.name);
    return parts.join(', ');
  }
  if (isHome) {
    return 'herramientas online, herramientas gratis, calculadoras online, generadores online, convertidores, utilidades web';
  }
  return '';
})();

const SHORT_NAMES: Record<string, string> = {
  'redes-mensajeria': 'Redes',
  'sorteos-diversion': 'Sorteos',
  'dinero-compras': 'Dinero',
  'fechas-tiempo': 'Fechas',
  'estudio-trabajo': 'Estudio',
  'hogar-vida': 'Hogar',
  'imagenes-multimedia': 'Imágenes',
  'texto-utilidades': 'Texto'
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {autoKeywords && <meta name="keywords" content={autoKeywords} />}
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:site_name" content="HerramientasOnline" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0d1117" />

    <!-- JSON-LD: WebSite (sitelinks + search box) -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- JSON-LD: SiteNavigationElement (tool sitelinks in Google) -->
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(navigationSchema)} />}

    <!-- JSON-LD: WebApplication (individual tool pages) -->
    {toolSchema && <script type="application/ld+json" set:html={JSON.stringify(toolSchema)} />}

    <!-- JSON-LD: BreadcrumbList -->
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    {client && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${client}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <header class="site">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-badge">⚡</span>
          <span class="brand-name">Herramientas<span class="brand-accent">Online</span></span>
        </a>

        <!-- Desktop Navigation with Dropdowns -->
        <nav class="nav-desktop" aria-label="Navegación principal">
          {CATEGORIES.map((cat) => {
            const catTools = ALL_TOOLS.filter((t) => t.category === cat.id);
            const shortName = SHORT_NAMES[cat.id] || cat.name;
            return (
              <div class="nav-dropdown-group">
                <a href={`/categoria/${cat.id}`} class="nav-category-trigger">
                  <span>{shortName}</span>
                  <Icon name="chevron-down" size={13} class="dropdown-chevron" />
                </a>

                <div class="nav-dropdown-menu">
                  <div class="dropdown-header">
                    <span class="dropdown-title">{cat.name}</span>
                    <a href={`/categoria/${cat.id}`} class="dropdown-view-all">Ver sección &rarr;</a>
                  </div>
                  <div class="dropdown-items">
                    {catTools.map((tool) => (
                      <a href={tool.href} class="dropdown-tool-link">
                        <div class="dropdown-tool-icon">
                          <Icon name={tool.icon} size={15} />
                        </div>
                        <span class="dropdown-tool-name">{tool.name}</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          })}
        </nav>

        <!-- Mobile Menu Toggle Button -->
        <button type="button" class="mobile-toggle" id="btn-mobile-toggle" aria-label="Abrir menú">
          <span class="burger-line"></span>
          <span class="burger-line"></span>
          <span class="burger-line"></span>
        </button>
      </div>

      <!-- Mobile Dropdown Accordion Menu -->
      <div class="mobile-menu" id="mobile-menu">
        <div class="mobile-menu-inner">
          {CATEGORIES.map((cat) => {
            const catTools = ALL_TOOLS.filter((t) => t.category === cat.id);
            return (
              <div class="mobile-cat-group">
                <a href={`/categoria/${cat.id}`} class="mobile-cat-title">
                  <Icon name={cat.icon} size={17} />
                  <span>{cat.name}</span>
                  <span class="mobile-badge-count">{catTools.length}</span>
                </a>
                <div class="mobile-tools-sub">
                  {catTools.map((tool) => (
                    <a href={tool.href} class="mobile-tool-item">
                      <Icon name={tool.icon} size={13} />
                      <span>{tool.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </header>

    <main class="wrap">
      {topAd && <AdSlot position="Superior" />}
      <slot />
      <AdSlot position="Inferior" />
    </main>

    <footer class="site">
      <div class="wrap footer-content">
        <div>
          © {new Date().getFullYear()} Herramientas Online · Privado y en tu navegador.
        </div>
        <div class="footer-links">
          <a href="/">Inicio</a>
          <a href="/acerca">Acerca de</a>
          <a href="/privacidad">Privacidad</a>
          <a href="/terminos">Términos</a>
          <a href="/contacto">Contacto</a>
        </div>
      </div>
    </footer>

    <script>
      const btnToggle = document.getElementById('btn-mobile-toggle');
      const mobileMenu = document.getElementById('mobile-menu');

      if (btnToggle && mobileMenu) {
        btnToggle.addEventListener('click', () => {
          mobileMenu.classList.toggle('is-open');
          btnToggle.classList.toggle('is-active');
        });
      }
    </script>
  </body>
</html>

<style>
  /* Header Layout */
  .header-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0.65rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--ink);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .brand-badge {
    font-size: 1.2rem;
  }
  .brand-accent {
    color: var(--accent);
  }

  /* Desktop Nav */
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  @media (max-width: 960px) {
    .nav-desktop {
      display: none;
    }
  }

  .nav-dropdown-group {
    position: relative;
    padding-block: 0.25rem;
  }

  .nav-category-trigger {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .nav-category-trigger:hover,
  .nav-dropdown-group:hover .nav-category-trigger {
    color: var(--ink);
    background: var(--surface-hover);
    text-decoration: none;
  }

  .dropdown-chevron {
    color: var(--muted);
    transition: transform 0.2s ease;
  }
  .nav-dropdown-group:hover .dropdown-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }

  /* Dropdown Floating Menu */
  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 280px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    padding: 0.6rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 100;
    backdrop-filter: blur(12px);
  }

  .nav-dropdown-group:hover .nav-dropdown-menu,
  .nav-dropdown-group:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.35rem 0.6rem 0.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 0.4rem;
  }

  .dropdown-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .dropdown-view-all {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .dropdown-view-all:hover {
    text-decoration: underline;
  }

  .dropdown-items {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-height: 380px;
    overflow-y: auto;
  }

  .dropdown-tool-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.84rem;
    font-weight: 500;
    transition: background 0.12s ease;
  }

  .dropdown-tool-link:hover {
    background: var(--surface-hover);
    color: var(--accent);
    text-decoration: none;
  }

  .dropdown-tool-icon {
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    flex-shrink: 0;
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    flex-direction: column;
    gap: 4px;
  }
  @media (max-width: 960px) {
    .mobile-toggle {
      display: flex;
    }
  }

  .burger-line {
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: all 0.2s;
  }

  /* Mobile Drawer Menu */
  .mobile-menu {
    display: none;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 960px) {
    .mobile-menu {
      display: block;
    }
    .mobile-menu.is-open {
      max-height: 80vh;
      overflow-y: auto;
    }
  }

  .mobile-menu-inner {
    padding: 1rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-cat-group {
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.8rem;
  }
  .mobile-cat-group:last-child {
    border-bottom: none;
  }

  .mobile-cat-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 0.5rem;
  }

  .mobile-badge-count {
    margin-left: auto;
    font-size: 0.72rem;
    padding: 2px 7px;
    border-radius: 10px;
    background: var(--surface-card);
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .mobile-tools-sub {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding-left: 1.8rem;
  }

  .mobile-tool-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84rem;
    color: var(--muted);
    text-decoration: none;
    padding: 0.25rem 0;
  }
  .mobile-tool-item:hover {
    color: var(--accent);
  }
</style>
