---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES, ALL_TOOLS } from '../data/tools';

interface Props {
  title: string;
  description: string;
  topAd?: boolean;
  keywords?: string;
}

const { title, description, topAd = false, keywords = '' } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://tudominio.com';
const canonical = new URL(Astro.url.pathname, Astro.site);
const pagePath = Astro.url.pathname;
const isHome = pagePath === '/' || pagePath === '';

// Find current tool info for individual tool pages
const currentTool = ALL_TOOLS.find((t) => t.href === pagePath);

// JSON-LD: WebSite schema (shown on all pages, enables sitelinks search box)
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'UtiliaOnline',
  url: siteUrl,
  description: 'UtiliaOnline: herramientas web prácticas para el día a día. La mayoría de las herramientas funcionan directamente en tu navegador sin enviar datos a servidores.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/?q={search_term_string}`
    },
    'query-input': 'required name=search_term_string'
  }
};

// JSON-LD: SiteNavigationElement (helps Google generate sitelinks to individual tools)
const navElements = ALL_TOOLS.filter(t => t.status === 'ready').map((tool) => ({
  '@type': 'SiteNavigationElement',
  name: tool.name,
  description: tool.desc,
  url: `${siteUrl}${tool.href}`
}));

const navigationSchema = {
  '@context': 'https://schema.org',
  '@graph': navElements
};

// JSON-LD: WebApplication schema for individual tool pages
const toolSchema = currentTool ? {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: currentTool.name,
  description: currentTool.desc,
  url: `${siteUrl}${currentTool.href}`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  },
  browserRequirements: 'Requiere JavaScript. Funciona en Chrome, Firefox, Safari, Edge.',
  isPartOf: {
    '@type': 'WebSite',
    name: 'UtiliaOnline',
    url: siteUrl
  }
} : null;

// JSON-LD: BreadcrumbList for tool pages
const currentCategory = currentTool
  ? CATEGORIES.find(c => c.id === currentTool.category)
  : null;

const breadcrumbSchema = currentTool && currentCategory ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: siteUrl
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: currentCategory.name,
      item: `${siteUrl}/categoria/${currentCategory.id}`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: currentTool.name,
      item: `${siteUrl}${currentTool.href}`
    }
  ]
} : null;

// Auto-generate keywords for tool pages from tool name/desc if none explicitly passed
const autoKeywords = (() => {
  if (keywords) return keywords;
  if (currentTool) {
    const parts = [
      currentTool.name,
      'herramienta online',
      'gratis',
      'en línea',
      currentTool.desc.split('.')[0]
    ];
    if (currentCategory) parts.push(currentCategory.name);
    return parts.join(', ');
  }
  if (isHome) {
    return 'utilia online, herramientas online, herramientas gratis, calculadoras online, generadores online, convertidores, utilidades web';
  }
  return '';
})();

const SHORT_NAMES: Record<string, string> = {
  'redes-mensajeria': 'Redes',
  'sorteos-diversion': 'Sorteos',
  'dinero-compras': 'Dinero',
  'fechas-tiempo': 'Fechas',
  'estudio-trabajo': 'Estudio',
  'hogar-vida': 'Hogar',
  'imagenes-multimedia': 'Imágenes',
  'texto-utilidades': 'Texto'
};
---

<!doctype html>
<html lang="es-419">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {autoKeywords && <meta name="keywords" content={autoKeywords} />}
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:site_name" content="UtiliaOnline" />
    <meta property="og:locale" content="es_LA" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0d1117" />

    <!-- JSON-LD: WebSite (sitelinks + search box) -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- JSON-LD: SiteNavigationElement (tool sitelinks in Google) -->
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(navigationSchema)} />}

    <!-- JSON-LD: WebApplication (individual tool pages) -->
    {toolSchema && <script type="application/ld+json" set:html={JSON.stringify(toolSchema)} />}

    <!-- JSON-LD: BreadcrumbList -->
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    {client && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${client}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <header class="site">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="UtiliaOnline - Inicio">
          <span class="brand-badge">⚡</span>
          <span class="brand-name">Utilia<span class="brand-accent">Online</span></span>
        </a>

        <!-- Desktop Navigation: Categorías directas (sin duplicar 43 links en cada render) -->
        <nav class="nav-desktop" aria-label="Categorías de herramientas">
          {CATEGORIES.map((cat) => {
            const shortName = SHORT_NAMES[cat.id] || cat.name;
            const isCatActive = pagePath === `/categoria/${cat.id}` || currentCategory?.id === cat.id;
            return (
              <a 
                href={`/categoria/${cat.id}`} 
                class={`nav-cat-btn ${isCatActive ? 'is-active' : ''}`}
                title={`Ver herramientas de ${cat.name}`}
              >
                <span>{shortName}</span>
              </a>
            );
          })}
        </nav>

        <!-- Mobile Menu Toggle Button -->
        <button type="button" class="mobile-toggle" id="btn-mobile-toggle" aria-label="Abrir menú de categorías">
          <span class="burger-line"></span>
          <span class="burger-line"></span>
          <span class="burger-line"></span>
        </button>
      </div>

      <!-- Mobile Navigation Drawer: Categorías organizadas -->
      <div class="mobile-menu" id="mobile-menu">
        <div class="mobile-menu-inner">
          <div class="mobile-cat-headline">Explorar herramientas por categoría:</div>
          <div class="mobile-cat-list">
            {CATEGORIES.map((cat) => {
              const catCount = ALL_TOOLS.filter((t) => t.category === cat.id).length;
              const isCatActive = pagePath === `/categoria/${cat.id}` || currentCategory?.id === cat.id;
              return (
                <a href={`/categoria/${cat.id}`} class={`mobile-cat-row ${isCatActive ? 'is-active' : ''}`}>
                  <div class="mobile-cat-row-icon">
                    <Icon name={cat.icon} size={18} />
                  </div>
                  <div class="mobile-cat-row-info">
                    <strong>{cat.name}</strong>
                    <small>{catCount} herramientas</small>
                  </div>
                  <span class="mobile-cat-row-arrow">&rarr;</span>
                </a>
              );
            })}
          </div>
          <div class="mobile-secondary-links">
            <a href="/">Inicio</a>
            <a href="/acerca">Acerca de</a>
            <a href="/privacidad">Privacidad</a>
            <a href="/contacto">Contacto</a>
          </div>
        </div>
      </div>
    </header>

    <main class="wrap">
      {topAd && <AdSlot position="Superior" />}
      <slot />
      <AdSlot position="Inferior" />
    </main>

    <footer class="site">
      <div class="wrap footer-content">
        <div>
          © {new Date().getFullYear()} UtiliaOnline · La mayoría de las herramientas funcionan en tu navegador.
        </div>
        <div class="footer-links">
          <a href="/">Inicio</a>
          <a href="/acerca">Acerca de</a>
          <a href="/privacidad">Privacidad</a>
          <a href="/terminos">Términos</a>
          <a href="/contacto">Contacto</a>
        </div>
      </div>
    </footer>

    <script>
      const btnToggle = document.getElementById('btn-mobile-toggle');
      const mobileMenu = document.getElementById('mobile-menu');

      if (btnToggle && mobileMenu) {
        btnToggle.addEventListener('click', () => {
          mobileMenu.classList.toggle('is-open');
          btnToggle.classList.toggle('is-active');
        });
      }
    </script>
  </body>
</html>

<style>
  /* Header Layout */
  .header-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0.65rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--ink);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .brand-badge {
    font-size: 1.2rem;
  }
  .brand-accent {
    color: var(--accent);
  }

  /* Desktop Nav */
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  @media (max-width: 960px) {
    .nav-desktop {
      display: none;
    }
  }

  .nav-cat-btn {
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .nav-cat-btn:hover {
    color: var(--ink);
    background: var(--surface-hover);
    text-decoration: none;
  }

  .nav-cat-btn.is-active {
    color: #fff;
    background: var(--accent);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    flex-direction: column;
    gap: 4px;
  }
  @media (max-width: 960px) {
    .mobile-toggle {
      display: flex;
    }
  }

  .burger-line {
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: all 0.2s;
  }

  /* Mobile Drawer Menu */
  .mobile-menu {
    display: none;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 960px) {
    .mobile-menu {
      display: block;
    }
    .mobile-menu.is-open {
      max-height: 85vh;
      overflow-y: auto;
    }
  }

  .mobile-menu-inner {
    padding: 1rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .mobile-cat-headline {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }

  .mobile-cat-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }

  .mobile-cat-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: var(--surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    transition: all 0.15s ease;
  }

  .mobile-cat-row:hover,
  .mobile-cat-row.is-active {
    border-color: var(--accent);
    background: var(--surface-hover);
    text-decoration: none;
  }

  .mobile-cat-row-icon {
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: rgba(47, 129, 247, 0.1);
    flex-shrink: 0;
  }

  .mobile-cat-row-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .mobile-cat-row-info strong {
    font-size: 0.92rem;
    font-weight: 600;
  }

  .mobile-cat-row-info small {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .mobile-cat-row-arrow {
    color: var(--muted);
    font-size: 1rem;
  }

  .mobile-secondary-links {
    display: flex;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    margin-top: 0.5rem;
    font-size: 0.86rem;
  }

  .mobile-secondary-links a {
    color: var(--muted);
  }
  .mobile-secondary-links a:hover {
    color: var(--ink);
  }
</style>
