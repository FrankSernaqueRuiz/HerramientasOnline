---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Limpiador de Texto Copiado de PDF Online"
  description="Elimina saltos de línea rotos, guiones al final de línea y espacios duplicados típicos al copiar texto de documentos PDF."
>
  <div class="page-header">
    <div class="breadcrumb">
      <a href="/">Herramientas</a> / <span>Redes sociales y mensajería</span>
    </div>
    <h1>Limpiador de Texto Copiado de PDF</h1>
    <p class="lead">Pega el texto extraído de tu PDF y arregla al instante los párrafos partidos, guiones de separación silábica y espaciados accidentales.</p>
  </div>

  <section class="panel">
    <div class="options-toolbar">
      <label class="check-opt">
        <input type="checkbox" id="opt-join-lines" checked />
        <span>Unir líneas cortadas (reparar párrafos)</span>
      </label>
      <label class="check-opt">
        <input type="checkbox" id="opt-remove-hyphens" checked />
        <span>Quitar guiones al final de línea (ej: con- <br/>secuencia ➔ consecuencia)</span>
      </label>
      <label class="check-opt">
        <input type="checkbox" id="opt-clean-spaces" checked />
        <span>Eliminar espacios dobles y múltiples</span>
      </label>
      <label class="check-opt">
        <input type="checkbox" id="opt-trim-lines" checked />
        <span>Recortar espacios al inicio y final</span>
      </label>
    </div>

    <div class="cleaner-split">
      <div class="text-pane">
        <div class="pane-header">
          <label for="input-pdf-text">Texto original copiado de PDF:</label>
          <button id="btn-paste-sample" class="btn-text-action" type="button">Probar ejemplo roto</button>
        </div>
        <textarea 
          id="input-pdf-text" 
          rows="10" 
          placeholder="Pega aquí el texto con saltos de línea desordenados..."
        ></textarea>
        <div class="pane-footer" id="orig-stats">0 caracteres · 0 palabras</div>
      </div>

      <div class="text-pane">
        <div class="pane-header">
          <label for="output-pdf-text">Texto limpio y continuo:</label>
          <div class="header-btns">
            <button id="btn-copy-clean" class="btn-primary-sm" type="button">
              <Icon name="copy" size={15} /> Copiar limpio
            </button>
          </div>
        </div>
        <textarea 
          id="output-pdf-text" 
          rows="10" 
          readonly 
          placeholder="Aquí aparecerá el texto limpio y listo para leer o citar..."
        ></textarea>
        <div class="pane-footer" id="clean-stats">0 caracteres · 0 palabras</div>
      </div>
    </div>

    <div class="actions">
      <button id="btn-clean-now" class="btn-primary" type="button">
        <Icon name="refresh" size={16} /> Procesar texto
      </button>
      <button id="btn-clear-all" class="btn-secondary" type="button">
        <Icon name="trash" size={16} /> Limpiar todo
      </button>
      <span id="copy-feedback" class="copy-feedback"></span>
    </div>
  </section>

  <section class="seo-section">
    <h2>¿Por qué los textos de PDF se copian rotos?</h2>
    <p>El formato PDF está diseñado para la composición visual en página física, no para el flujo continuo de texto. Por eso, al final de cada línea visual en el visor se suele insertar un retorno de carro <code>\n</code> rígido o guiones de separación tipográfica que arruinan la lectura al pegarlo en Word, WhatsApp o Google Docs. Esta herramienta restaura el flujo natural de los párrafos.</p>
  </section>
</Base>

<style>
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .breadcrumb a {
    color: var(--muted);
  }
  .options-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    background: var(--surface-card);
    border: 1px solid var(--line);
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.5rem;
  }
  .check-opt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    cursor: pointer;
    user-select: none;
  }
  .check-opt input {
    cursor: pointer;
  }
  .cleaner-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }
  @media (max-width: 768px) {
    .cleaner-split {
      grid-template-columns: 1fr;
    }
  }
  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.45rem;
  }
  .pane-header label {
    font-size: 0.88rem;
    font-weight: 600;
  }
  .btn-text-action {
    background: none;
    border: none;
    color: var(--accent);
    font-size: 0.8rem;
    cursor: pointer;
    padding: 0;
  }
  .btn-text-action:hover {
    text-decoration: underline;
  }
  .cleaner-split textarea {
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .pane-footer {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.35rem;
    text-align: right;
  }
  .btn-primary-sm {
    background: var(--accent);
    color: var(--accent-ink);
    border: none;
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--accent-ink);
    border: none;
    border-radius: var(--radius-sm);
    padding: 0.65rem 1.2rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
  }
  .btn-secondary {
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.65rem 1.2rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
  }
  .copy-feedback {
    color: #3fb950;
    font-size: 0.85rem;
    font-weight: 500;
    align-self: center;
    margin-left: 0.5rem;
  }
</style>

<script>
  const inputPdf = document.getElementById('input-pdf-text') as HTMLTextAreaElement;
  const outputPdf = document.getElementById('output-pdf-text') as HTMLTextAreaElement;
  const optJoinLines = document.getElementById('opt-join-lines') as HTMLInputElement;
  const optRemoveHyphens = document.getElementById('opt-remove-hyphens') as HTMLInputElement;
  const optCleanSpaces = document.getElementById('opt-clean-spaces') as HTMLInputElement;
  const optTrimLines = document.getElementById('opt-trim-lines') as HTMLInputElement;

  const btnClean = document.getElementById('btn-clean-now') as HTMLButtonElement;
  const btnClear = document.getElementById('btn-clear-all') as HTMLButtonElement;
  const btnCopy = document.getElementById('btn-copy-clean') as HTMLButtonElement;
  const btnSample = document.getElementById('btn-paste-sample') as HTMLButtonElement;
  const copyFeedback = document.getElementById('copy-feedback') as HTMLSpanElement;

  const origStats = document.getElementById('orig-stats') as HTMLDivElement;
  const cleanStats = document.getElementById('clean-stats') as HTMLDivElement;

  function updateStats(str: string, targetEl: HTMLElement) {
    const chars = str.length;
    const words = str.trim() ? str.trim().split(/\s+/).length : 0;
    targetEl.textContent = `${chars.toLocaleString()} caracteres · ${words.toLocaleString()} palabras`;
  }

  function cleanPdfText() {
    let text = inputPdf.value;
    updateStats(text, origStats);

    if (!text) {
      outputPdf.value = '';
      updateStats('', cleanStats);
      return;
    }

    // 1. Quitar guiones de final de línea (ej: pala-\nbra => palabra)
    if (optRemoveHyphens.checked) {
      text = text.replace(/([a-zA-ZáéíóúÁÉÍÓÚñÑ])-[\r\n]+([a-zA-ZáéíóúÁÉÍÓÚñÑ])/g, '$1$2');
    }

    // 2. Unir saltos de línea rotos que no sean párrafos genuinos (doble salto)
    if (optJoinLines.checked) {
      // Normalizar saltos a \n
      text = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
      // Preservar doble salto como marcador temporal de nuevo párrafo
      const PARAGRAPH_TOKEN = '___PARAGRAPH_BREAK___';
      text = text.replace(/\n\s*\n/g, PARAGRAPH_TOKEN);
      // Reemplazar saltos simples por espacio
      text = text.replace(/\n/g, ' ');
      // Restaurar párrafos con doble salto limpio
      text = text.split(PARAGRAPH_TOKEN).join('\n\n');
    }

    // 3. Limpiar espacios múltiples y tabs
    if (optCleanSpaces.checked) {
      text = text.replace(/[ \t]+/g, ' ');
    }

    // 4. Recorte de líneas
    if (optTrimLines.checked) {
      text = text
        .split('\n')
        .map((line) => line.trim())
        .join('\n')
        .trim();
    }

    outputPdf.value = text;
    updateStats(text, cleanStats);
  }

  inputPdf.addEventListener('input', cleanPdfText);
  [optJoinLines, optRemoveHyphens, optCleanSpaces, optTrimLines].forEach((chk) => {
    chk.addEventListener('change', cleanPdfText);
  });
  btnClean.addEventListener('click', cleanPdfText);

  btnClear.addEventListener('click', () => {
    inputPdf.value = '';
    outputPdf.value = '';
    updateStats('', origStats);
    updateStats('', cleanStats);
  });

  btnCopy.addEventListener('click', async () => {
    if (!outputPdf.value) return;
    try {
      await navigator.clipboard.writeText(outputPdf.value);
      copyFeedback.textContent = '✓ ¡Texto limpio copiado!';
      setTimeout(() => copyFeedback.textContent = '', 2500);
    } catch {
      copyFeedback.textContent = 'Error al copiar';
    }
  });

  btnSample.addEventListener('click', () => {
    inputPdf.value = `Este es un texto extraí-
do de un documento en for-
mato PDF con saltos de línea ar-
bitrarios en cada renglón.

Además tiene espa-
cios   dobles    y párrafos
que deberían mantenerse separados con
claridad visual.`;
    cleanPdfText();
  });
</script>
