  const topicSelect = document.getElementById('bio-topic') as HTMLSelectElement;
  const toneSelect = document.getElementById('bio-tone') as HTMLSelectElement;
  const ctaInput = document.getElementById('bio-cta') as HTMLInputElement;
  const btnGenerate = document.getElementById('btn-generate') as HTMLButtonElement;
  const btnGenerateText = document.getElementById('btn-generate-text') as HTMLSpanElement;
  const generateFeedback = document.getElementById('generate-feedback') as HTMLSpanElement;
  const biosList = document.getElementById('bios-list') as HTMLDivElement;
  const hashtagsBox = document.getElementById('hashtags-box') as HTMLDivElement;
  const btnCopyAllTags = document.getElementById('btn-copy-all-tags') as HTMLButtonElement;
  const tagsNotice = document.getElementById('tags-copied-notice') as HTMLDivElement;
  const ideasCounter = document.getElementById('ideas-counter') as HTMLSpanElement;

  // Track shown indices to avoid identical consecutive generations
  let lastShownIndices: number[] = [];
  let lastTopic = '';
  let lastTone = '';

  // Universal clipboard helper with fallback
  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {
      // ignore and fallback
    }

    try {
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-9999px';
      textArea.style.top = '-9999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      const success = document.execCommand('copy');
      document.body.removeChild(textArea);
      return success;
    } catch {
      return false;
    }
  }

  function pickVariedIndices(totalAvailable: number, countToPick: number): number[] {
    const allIndices = Array.from({ length: totalAvailable }, (_, i) => i);
    if (totalAvailable <= countToPick) {
      return allIndices.sort(() => Math.random() - 0.5);
    }

    // Filter out items shown in the immediate previous generation
    const available = allIndices.filter((i) => !lastShownIndices.includes(i));

    if (available.length >= countToPick) {
      const shuffled = [...available].sort(() => Math.random() - 0.5);
      return shuffled.slice(0, countToPick);
    }

    // If not enough unseen items, take all unseen and fill remainder from previous
    const shuffledAvailable = [...available].sort(() => Math.random() - 0.5);
    const needed = countToPick - shuffledAvailable.length;
    const shuffledLast = [...lastShownIndices].sort(() => Math.random() - 0.5);
    return [...shuffledAvailable, ...shuffledLast.slice(0, needed)];
  }

  function renderBioResults(isNewGeneration = false) {
    const topic = topicSelect.value;
    const tone = toneSelect.value as 'profesional' | 'cercano' | 'minimalista' | 'divertido';
    const cta = ctaInput.value.trim() || 'Link abajo 👇';

    const data = database[topic] || database.personal;
    const allTemplates = data.bios[tone] || data.bios.cercano;

    // Reset history if user changed topic or tone
    if (topic !== lastTopic || tone !== lastTone) {
      lastShownIndices = [];
      lastTopic = topic;
      lastTone = tone;
    }

    // Determine how many items to show (up to 3 distinct bios)
    const countToPick = Math.min(3, allTemplates.length);
    const chosenIndices = pickVariedIndices(allTemplates.length, countToPick);
    lastShownIndices = chosenIndices;

    const selectedTemplates = chosenIndices.map((idx) => allTemplates[idx]);

    biosList.innerHTML = '';
    if (ideasCounter) {
      ideasCounter.textContent = `${selectedTemplates.length} ideas sugeridas`;
    }

    selectedTemplates.forEach((tmpl) => {
      const fullBio = tmpl.replace('{cta}', cta);
      const charCount = fullBio.length;

      const card = document.createElement('div');
      card.className = 'bio-card';

      const bioText = document.createElement('div');
      bioText.className = 'bio-text';
      bioText.textContent = fullBio;

      const footer = document.createElement('div');
      footer.className = 'bio-footer';

      const countSpan = document.createElement('span');
      countSpan.textContent = `${charCount} / 150 caracteres`;

      if (charCount > 150) {
        countSpan.className = 'bio-count-danger';
        countSpan.textContent += ' (⚠️ Excede Instagram)';
      } else if (charCount > 140) {
        countSpan.className = 'bio-count-warn';
      } else {
        countSpan.className = 'bio-count-ok';
      }

      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'btn-copy-card';
      copyBtn.textContent = 'Copiar bio';

      copyBtn.addEventListener('click', async () => {
        const ok = await copyText(fullBio);
        if (ok) {
          copyBtn.classList.add('is-copied');
          copyBtn.textContent = '✓ ¡Copiado!';
          setTimeout(() => {
            copyBtn.classList.remove('is-copied');
            copyBtn.textContent = 'Copiar bio';
          }, 2000);
        }
      });

      footer.appendChild(countSpan);
      footer.appendChild(copyBtn);

      card.appendChild(bioText);
      card.appendChild(footer);
      biosList.appendChild(card);
    });

    // Render Hashtags (shuffled or highlighted)
    hashtagsBox.innerHTML = '';
    const allTags = [...data.hashtags];
    if (isNewGeneration) {
      allTags.sort(() => Math.random() - 0.5);
    }

    allTags.forEach((tag) => {
      const pill = document.createElement('span');
      pill.className = 'hashtag-pill';
      pill.textContent = tag;
      pill.title = 'Clic para copiar este hashtag';

      pill.addEventListener('click', async () => {
        const ok = await copyText(tag);
        if (ok) {
          tagsNotice.textContent = `✓ Copiado: ${tag}`;
          setTimeout(() => {
            tagsNotice.textContent = '';
          }, 2000);
        }
      });

      hashtagsBox.appendChild(pill);
    });

    // If triggered by Generate Button, show visual feedback
    if (isNewGeneration) {
      btnGenerate.classList.add('is-spinning');
      if (generateFeedback) {
        generateFeedback.textContent = '✨ ¡Nuevas ideas listas!';
        generateFeedback.classList.add('is-visible');
        setTimeout(() => {
          generateFeedback.classList.remove('is-visible');
        }, 2200);
      }
      setTimeout(() => {
        btnGenerate.classList.remove('is-spinning');
      }, 450);
    }
  }

  // Event Listeners
  btnGenerate.addEventListener('click', () => {
    renderBioResults(true);
  });

  topicSelect.addEventListener('change', () => {
    renderBioResults(false);
  });

  toneSelect.addEventListener('change', () => {
    renderBioResults(false);
  });

  ctaInput.addEventListener('input', () => {
    // Re-render current selection with updated CTA in place
    renderBioResults(false);
  });

  btnCopyAllTags.addEventListener('click', async () => {
    const topic = topicSelect.value;
    const data = database[topic] || database.personal;
    // Get all current pills in the container to respect current order
    const currentPills = Array.from(hashtagsBox.querySelectorAll('.hashtag-pill'));
    const all = currentPills.length > 0 
      ? currentPills.map(p => p.textContent).join(' ') 
      : data.hashtags.join(' ');

    const ok = await copyText(all);
    if (ok) {
      tagsNotice.textContent = '✓ ¡Todos los hashtags copiados al portapapeles!';
      btnCopyAllTags.textContent = '✓ Copiados';
      setTimeout(() => {
        tagsNotice.textContent = '';
        btnCopyAllTags.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> Copiar todos`;
      }, 2500);
    }
  });

  // Initial render on page load
  renderBioResults(false);
</script>
