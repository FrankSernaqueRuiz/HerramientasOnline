---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Planificador Visual de Horarios de Clase Semanal" description="Crea, organiza y personaliza tu horario semanal de universidad, instituto o colegio con colores, aulas y profesores. Imprime o guarda tu cronograma.">
  <div class="page-header">
    <div class="breadcrumb"><a href="/">Herramientas</a> / <span>Estudio y trabajo</span></div>
    <h1>Planificador Visual de Horarios de Clase</h1>
    <p class="lead">Organiza tus asignaturas por día y hora con bloques de colores. Tus datos se guardan automáticamente en tu navegador.</p>
  </div>

  <section class="panel">
    <!-- Form to add course -->
    <div class="schedule-form-card">
      <h3>+ Agregar Asignatura / Bloque</h3>
      <div class="schedule-form-grid">
        <div class="field">
          <label for="course-name">Materia / Curso:</label>
          <input type="text" id="course-name" placeholder="Ej. Cálculo II, Derecho Civil..." class="form-input" />
        </div>
        <div class="field">
          <label for="course-day">Día:</label>
          <select id="course-day" class="form-input">
            <option value="1">Lunes</option>
            <option value="2">Martes</option>
            <option value="3">Miércoles</option>
            <option value="4">Jueves</option>
            <option value="5">Viernes</option>
            <option value="6">Sábado</option>
          </select>
        </div>
        <div class="field">
          <label for="course-start">Hora inicio:</label>
          <select id="course-start" class="form-input">
            <option value="7">07:00</option>
            <option value="8" selected>08:00</option>
            <option value="9">09:00</option>
            <option value="10">10:00</option>
            <option value="11">11:00</option>
            <option value="12">12:00</option>
            <option value="13">13:00</option>
            <option value="14">14:00</option>
            <option value="15">15:00</option>
            <option value="16">16:00</option>
            <option value="17">17:00</option>
            <option value="18">18:00</option>
            <option value="19">19:00</option>
            <option value="20">20:00</option>
          </select>
        </div>
        <div class="field">
          <label for="course-end">Hora fin:</label>
          <select id="course-end" class="form-input">
            <option value="8">08:00</option>
            <option value="9">09:00</option>
            <option value="10" selected>10:00</option>
            <option value="11">11:00</option>
            <option value="12">12:00</option>
            <option value="13">13:00</option>
            <option value="14">14:00</option>
            <option value="15">15:00</option>
            <option value="16">16:00</option>
            <option value="17">17:00</option>
            <option value="18">18:00</option>
            <option value="19">19:00</option>
            <option value="20">20:00</option>
            <option value="21">21:00</option>
            <option value="22">22:00</option>
          </select>
        </div>
        <div class="field">
          <label for="course-room">Aula / Docente (opcional):</label>
          <input type="text" id="course-room" placeholder="Ej. Aula 304 • Prof. Soto" class="form-input" />
        </div>
        <div class="field">
          <label for="course-color">Color:</label>
          <div class="color-picker-row">
            <input type="color" id="course-color" value="#3b82f6" class="color-swatch" />
            <button type="button" class="btn btn-primary" id="btn-add-course" style="flex:1;">Agregar al horario</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions toolbar -->
    <div class="timetable-actions">
      <button type="button" class="btn btn-secondary btn-sm" id="btn-print">🖨️ Imprimir / Guardar PDF</button>
      <button type="button" class="btn btn-secondary btn-sm" id="btn-clear">🗑️ Limpiar horario</button>
    </div>

    <!-- Timetable Grid -->
    <div class="timetable-wrapper" id="printable-area">
      <table class="timetable">
        <thead>
          <tr>
            <th class="time-col">Hora</th>
            <th>Lunes</th>
            <th>Martes</th>
            <th>Miércoles</th>
            <th>Jueves</th>
            <th>Viernes</th>
            <th>Sábado</th>
          </tr>
        </thead>
        <tbody id="timetable-body">
          <!-- Rows from 07:00 to 21:00 -->
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .breadcrumb{font-size:.85rem;color:var(--muted);margin-bottom:.5rem}.breadcrumb a{color:var(--muted)}
  .schedule-form-card{background:var(--surface-card);border:1px solid var(--line);border-radius:var(--radius-sm);padding:1.25rem;margin-bottom:1.5rem}
  .schedule-form-card h3{font-size:1rem;margin-bottom:1rem}
  .schedule-form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:.85rem;align-items:end}
  .field label{display:block;font-weight:600;font-size:.82rem;margin-bottom:.3rem}
  .form-input{width:100%;padding:.5rem .65rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font:inherit}
  .color-picker-row{display:flex;gap:.5rem;align-items:center}
  .color-swatch{width:42px;height:38px;padding:2px;border:1px solid var(--line);border-radius:var(--radius-sm);background:transparent;cursor:pointer}

  .timetable-actions{display:flex;justify-content:flex-end;gap:.75rem;margin-bottom:1rem}

  .timetable-wrapper{overflow-x:auto;background:var(--surface-card);border:1px solid var(--line);border-radius:var(--radius-sm)}
  .timetable{width:100%;min-width:700px;border-collapse:collapse}
  .timetable th{background:var(--bg);padding:.6rem .5rem;font-size:.85rem;font-weight:700;border:1px solid var(--line);text-align:center}
  .timetable td{border:1px solid var(--line);height:42px;padding:2px;vertical-align:top;position:relative}
  .timetable .time-col{width:65px;text-align:center;font-size:.78rem;font-weight:600;color:var(--muted);background:var(--bg)}

  :global(.course-block){border-radius:4px;padding:4px 6px;color:#fff;font-size:.76rem;font-weight:600;height:100%;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.15)}
  :global(.course-block .c-title){font-weight:700;line-height:1.2}
  :global(.course-block .c-room){font-size:.68rem;opacity:.9;margin-top:2px}
  :global(.course-block .btn-del-block){position:absolute;top:2px;right:2px;background:rgba(0,0,0,.3);border:none;color:#fff;border-radius:50%;width:16px;height:16px;font-size:10px;cursor:pointer;display:none;align-items:center;justify-content:center}
  :global(.course-block:hover .btn-del-block){display:flex}

  @media print {
    body * {visibility:hidden}
    #printable-area, #printable-area * {visibility:visible}
    #printable-area {position:absolute;left:0;top:0;width:100%}
    .btn-del-block {display:none !important}
  }
</style>

<script>
  interface Course {
    id: string;
    name: string;
    day: number;
    start: number;
    end: number;
    room: string;
    color: string;
  }

  const STORAGE_KEY = 'herramientas_horarios_v1';
  let courses: Course[] = [];

  const stored = localStorage.getItem(STORAGE_KEY);
  if (stored) {
    try { courses = JSON.parse(stored); } catch (e) { courses = []; }
  } else {
    // Presets
    courses = [
      { id: '1', name: 'Matemática I', day: 1, start: 8, end: 10, room: 'Aula 201', color: '#3b82f6' },
      { id: '2', name: 'Física General', day: 2, start: 10, end: 12, room: 'Lab 3', color: '#10b981' },
      { id: '3', name: 'Programación Web', day: 3, start: 14, end: 17, room: 'Lab Cómputo', color: '#8b5cf6' },
      { id: '4', name: 'Inglés Técnico', day: 4, start: 8, end: 10, room: 'Aula 105', color: '#f59e0b' }
    ];
  }

  const nameInput = document.getElementById('course-name') as HTMLInputElement;
  const dayInput = document.getElementById('course-day') as HTMLSelectElement;
  const startInput = document.getElementById('course-start') as HTMLSelectElement;
  const endInput = document.getElementById('course-end') as HTMLSelectElement;
  const roomInput = document.getElementById('course-room') as HTMLInputElement;
  const colorInput = document.getElementById('course-color') as HTMLInputElement;
  const btnAdd = document.getElementById('btn-add-course')!;
  const btnPrint = document.getElementById('btn-print')!;
  const btnClear = document.getElementById('btn-clear')!;
  const tbody = document.getElementById('timetable-body')!;

  function save() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(courses));
  }

  function renderGrid() {
    tbody.innerHTML = '';
    // Hours 7 to 21
    for (let h = 7; h <= 21; h++) {
      const tr = document.createElement('tr');
      const timeLabel = `${String(h).padStart(2,'0')}:00`;
      let cellsHtml = `<td class="time-col">${timeLabel}</td>`;

      for (let day = 1; day <= 6; day++) {
        // Find if any course covers this slot
        const matchingCourse = courses.find(c => c.day === day && h >= c.start && h < c.end);
        if (matchingCourse) {
          // If this is the start hour of the block
          if (h === matchingCourse.start) {
            const span = matchingCourse.end - matchingCourse.start;
            cellsHtml += `
              <td rowspan="${span}" style="padding:2px;">
                <div class="course-block" style="background:${matchingCourse.color};">
                  <span class="c-title">${matchingCourse.name}</span>
                  ${matchingCourse.room ? `<span class="c-room">${matchingCourse.room}</span>` : ''}
                  <button type="button" class="btn-del-block" data-id="${matchingCourse.id}">✕</button>
                </div>
              </td>
            `;
          }
          // If continuing hour, td is skipped by rowspan
        } else {
          cellsHtml += `<td></td>`;
        }
      }
      tr.innerHTML = cellsHtml;
      tbody.appendChild(tr);
    }

    // Attach delete listeners
    tbody.querySelectorAll('.btn-del-block').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (e.currentTarget as HTMLElement).dataset.id;
        courses = courses.filter(c => c.id !== id);
        save();
        renderGrid();
      });
    });
  }

  btnAdd.addEventListener('click', () => {
    const name = nameInput.value.trim();
    if (!name) {
      alert('Por favor escribe el nombre de la materia');
      return;
    }
    const day = parseInt(dayInput.value, 10);
    const start = parseInt(startInput.value, 10);
    const end = parseInt(endInput.value, 10);

    if (start >= end) {
      alert('La hora de fin debe ser posterior a la de inicio.');
      return;
    }

    const newCourse: Course = {
      id: Date.now().toString(),
      name,
      day,
      start,
      end,
      room: roomInput.value.trim(),
      color: colorInput.value
    };

    courses.push(newCourse);
    save();
    renderGrid();
    nameInput.value = '';
    roomInput.value = '';
  });

  btnPrint.addEventListener('click', () => {
    window.print();
  });

  btnClear.addEventListener('click', () => {
    if (confirm('¿Seguro que deseas vaciar todo el horario?')) {
      courses = [];
      save();
      renderGrid();
    }
  });

  renderGrid();
</script>
