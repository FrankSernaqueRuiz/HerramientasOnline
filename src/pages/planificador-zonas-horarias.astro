---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Planificador de Zonas Horarias – Coordina Reuniones Internacionales" description="Visualiza y compara la hora en múltiples países en tiempo real. Encuentra fácilmente la mejor hora para llamadas internacionales.">
  <div class="page-header">
    <div class="breadcrumb"><a href="/">Herramientas</a> / <span>Fechas y tiempo</span></div>
    <h1>Planificador de Zonas Horarias</h1>
    <p class="lead">Desplaza la hora base para sincronizar zonas horarias entre diferentes ciudades del mundo y encuentra el horario ideal para tus reuniones.</p>
  </div>

  <section class="panel">
    <div class="tz-controls">
      <div class="control-row">
        <label for="base-date"><strong>Fecha de referencia:</strong></label>
        <input type="date" id="base-date" class="tz-date-input" />
        <label for="hour-slider"><strong>Hora base (<span id="current-hour-label">12:00</span>):</strong></label>
        <input type="range" id="hour-slider" min="0" max="23" value="12" step="1" class="slider" />
      </div>

      <div class="add-city-row">
        <label for="city-select">Agregar ciudad / país:</label>
        <div class="select-wrapper">
          <select id="city-select">
            <option value="America/Mexico_City|Ciudad de México">🇲🇽 Ciudad de México (GMT-6)</option>
            <option value="America/Bogota|Bogotá / Lima / Quito">🇨🇴 Bogotá / 🇵🇪 Lima / 🇪🇨 Quito (GMT-5)</option>
            <option value="America/Buenos_Aires|Buenos Aires / Santiago">🇦🇷 Buenos Aires / 🇨🇱 Santiago (GMT-3)</option>
            <option value="America/New_York|Nueva York / Miami">🇺🇸 Nueva York (GMT-5 / EDT)</option>
            <option value="America/Los_Angeles|Los Ángeles">🇺🇸 Los Ángeles (GMT-8 / PDT)</option>
            <option value="Europe/Madrid|Madrid / Barcelona">🇪🇸 Madrid / Barcelona (GMT+1 / CEST)</option>
            <option value="Europe/London|Londres">🇬🇧 Londres (GMT / BST)</option>
            <option value="Asia/Tokyo|Tokio">🇯🇵 Tokio (GMT+9)</option>
            <option value="Australia/Sydney|Sídney">🇦🇺 Sídney (GMT+10)</option>
            <option value="Asia/Dubai|Dubái">🇦🇪 Dubái (GMT+4)</option>
          </select>
          <button type="button" class="btn btn-secondary btn-sm" id="btn-add-city">+ Agregar</button>
        </div>
      </div>
    </div>

    <div class="timeline-container" id="timeline-container">
      <!-- Generated by JS -->
    </div>

    <div class="legend">
      <span class="legend-item"><span class="badge-dot green"></span> Horario laboral ideal (9:00 - 18:00)</span>
      <span class="legend-item"><span class="badge-dot orange"></span> Horario ajustado (7:00 - 9:00 o 18:00 - 22:00)</span>
      <span class="legend-item"><span class="badge-dot red"></span> Noche / Fuera de horario</span>
    </div>
  </section>
</Base>

<style>
  .breadcrumb{font-size:.85rem;color:var(--muted);margin-bottom:.5rem}.breadcrumb a{color:var(--muted)}
  .tz-controls{display:flex;flex-direction:column;gap:1.25rem;margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid var(--line)}
  .control-row{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
  .tz-date-input{padding:.45rem .75rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font:inherit}
  .slider{flex:1;min-width:200px;accent-color:var(--accent);cursor:pointer}
  .add-city-row{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
  .select-wrapper{display:flex;gap:.5rem;align-items:center}
  select{padding:.5rem .75rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font:inherit}

  .timeline-container{display:flex;flex-direction:column;gap:1rem}
  :global(.tz-card){background:var(--surface-card);border:1px solid var(--line);border-radius:var(--radius-sm);padding:1rem;display:grid;grid-template-columns:220px 1fr auto;gap:1rem;align-items:center}
  @media(max-width:768px){:global(.tz-card){grid-template-columns:1fr;}}
  :global(.tz-city-info .city-name){font-weight:700;font-size:1.05rem;display:block}
  :global(.tz-city-info .city-time){font-size:1.4rem;font-weight:800;color:var(--accent)}
  :global(.tz-city-info .city-diff){font-size:.8rem;color:var(--muted)}

  :global(.tz-hours-bar){display:grid;grid-template-columns:repeat(24,1fr);gap:2px;background:var(--bg);padding:4px;border-radius:4px;overflow-x:auto}
  :global(.tz-hour-cell){text-align:center;font-size:.68rem;padding:6px 2px;border-radius:2px;font-weight:600;color:var(--ink)}
  :global(.tz-hour-cell.work){background:rgba(34,197,94,.18);color:#16a34a;border:1px solid rgba(34,197,94,.3)}
  :global(.tz-hour-cell.edge){background:rgba(234,179,8,.18);color:#ca8a04;border:1px solid rgba(234,179,8,.3)}
  :global(.tz-hour-cell.night){background:rgba(239,68,68,.1);color:var(--muted);opacity:.7}
  :global(.tz-hour-cell.selected){outline:2px solid var(--accent);transform:scale(1.1);font-weight:800;z-index:2}

  :global(.btn-remove-city){background:transparent;border:none;color:var(--muted);cursor:pointer;padding:.4rem;font-size:1.1rem;border-radius:4px}
  :global(.btn-remove-city:hover){color:#ef4444;background:rgba(239,68,68,.1)}

  .legend{display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:1.5rem;font-size:.85rem;color:var(--muted)}
  .legend-item{display:flex;align-items:center;gap:.4rem}
  .badge-dot{width:10px;height:10px;border-radius:50%;display:inline-block}
  .badge-dot.green{background:#22c55e}
  .badge-dot.orange{background:#eab308}
  .badge-dot.red{background:#ef4444}
</style>

<script>
  let selectedCities = [
    { zone: 'America/Mexico_City', name: '🇲🇽 Ciudad de México' },
    { zone: 'America/Bogota', name: '🇨🇴 Bogotá / Lima' },
    { zone: 'America/Buenos_Aires', name: '🇦🇷 Buenos Aires' },
    { zone: 'Europe/Madrid', name: '🇪🇸 Madrid / Barcelona' }
  ];

  const dateInput = document.getElementById('base-date') as HTMLInputElement;
  const hourSlider = document.getElementById('hour-slider') as HTMLInputElement;
  const hourLabel = document.getElementById('current-hour-label')!;
  const container = document.getElementById('timeline-container')!;
  const citySelect = document.getElementById('city-select') as HTMLSelectElement;
  const btnAdd = document.getElementById('btn-add-city')!;

  // Default to today
  const today = new Date();
  dateInput.value = today.toISOString().split('T')[0];

  function render() {
    const baseHour = parseInt(hourSlider.value, 10);
    hourLabel.textContent = `${String(baseHour).padStart(2, '0')}:00`;
    const selectedDate = dateInput.value || today.toISOString().split('T')[0];

    container.innerHTML = '';

    // Create date anchor in UTC
    const refUtc = new Date(Date.parse(`${selectedDate}T${String(baseHour).padStart(2,'0')}:00:00Z`));

    selectedCities.forEach((item, index) => {
      const card = document.createElement('div');
      card.className = 'tz-card';

      // Format time in timezone
      const timeFmt = new Intl.DateTimeFormat('es-ES', {
        timeZone: item.zone,
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      }).format(refUtc);

      const dateFmt = new Intl.DateTimeFormat('es-ES', {
        timeZone: item.zone,
        weekday: 'short',
        day: 'numeric',
        month: 'short'
      }).format(refUtc);

      let barHtml = '<div class="tz-hours-bar">';
      for (let h = 0; h < 24; h++) {
        const testDate = new Date(Date.parse(`${selectedDate}T${String(h).padStart(2,'0')}:00:00Z`));
        const localHourStr = new Intl.DateTimeFormat('en-US', {
          timeZone: item.zone,
          hour: 'numeric',
          hour12: false
        }).format(testDate);
        const lh = parseInt(localHourStr, 10);

        let statusClass = 'night';
        if (lh >= 9 && lh <= 18) statusClass = 'work';
        else if ((lh >= 7 && lh < 9) || (lh > 18 && lh <= 22)) statusClass = 'edge';

        const isSelected = h === baseHour ? 'selected' : '';
        barHtml += `<div class="tz-hour-cell ${statusClass} ${isSelected}" title="${lh}:00">${lh}</div>`;
      }
      barHtml += '</div>';

      card.innerHTML = `
        <div class="tz-city-info">
          <span class="city-name">${item.name}</span>
          <span class="city-time">${timeFmt}</span>
          <span class="city-diff">${dateFmt} • ${item.zone.replace('_',' ')}</span>
        </div>
        ${barHtml}
        <button class="btn-remove-city" title="Eliminar ciudad" data-idx="${index}">✕</button>
      `;

      container.appendChild(card);
    });

    // Wire remove buttons
    container.querySelectorAll('.btn-remove-city').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0', 10);
        selectedCities.splice(idx, 1);
        render();
      });
    });
  }

  hourSlider.addEventListener('input', render);
  dateInput.addEventListener('change', render);

  btnAdd.addEventListener('click', () => {
    const val = citySelect.value;
    const [zone, name] = val.split('|');
    if (!selectedCities.some(c => c.zone === zone)) {
      selectedCities.push({ zone, name });
      render();
    }
  });

  render();
</script>
