// ══════════════════════════════════════════════════
[courseNameEl, teacherNameEl, periodNameEl].forEach(function(el) {
  el.addEventListener('input', saveFields);
});

notaMinInput.addEventListener('input', function() {
  var v = parseFloat(notaMinInput.value);
  if (!isNaN(v)) {
    sh().notaMin = v;
    renderRows();
  }
});

notaMinInput.addEventListener('change', function() {
  var v = parseFloat(notaMinInput.value);
  sh().notaMin = isNaN(v) ? 11 : v;
  notaMinInput.value = sh().notaMin;
  renderRows();
});

gradeModeEl.addEventListener('change', function() {
  sh().gradeMode = gradeModeEl.value;
  notaMinPill.style.display = gradeModeEl.value === 'adbc' ? 'none' : '';
  renderColumns();
  renderRows();
});

searchInput.addEventListener('input', renderRows);
sortSelectEl.addEventListener('change', renderRows);

// ══════════════════════════════════════════════════
//  FULL RENDER INITIALIZATION
// ══════════════════════════════════════════════════
function fullRender() {
  loadFields();
  renderTabs();
  renderColumns();
  renderRows();
}

fullRender();
</script>
