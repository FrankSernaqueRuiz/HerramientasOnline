---
import CategoryHub from '../../components/CategoryHub.astro';
import { CATEGORIES, type Category } from '../../data/tools';

export function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { id: cat.id },
    props: { category: cat }
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<CategoryHub categoryId={category.id} />
