---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES, ALL_TOOLS, type Category } from '../../data/tools';

export function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { id: cat.id },
    props: { category: cat }
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const tools = ALL_TOOLS.filter((t) => t.category === category.id);
const otherCategories = CATEGORIES.filter((c) => c.id !== category.id);
---

<Base 
  title={`${category.name} – Herramientas Online Gratuitas y Privadas`} 
  description={`${category.desc} Acceso directo a todas las utilidades de ${category.name}.`}
>
  <div class="page-header cat-page-header">
    <div class="breadcrumb">
      <a href="/">Inicio</a> / <span>Categorías</span> / <span>{category.name}</span>
    </div>

    <div class="header-main-row">
      <div class="cat-page-icon">
        <Icon name={category.icon} size={32} />
      </div>
      <div>
        <h1>{category.name}</h1>
        <p class="lead">{category.desc}</p>
      </div>
    </div>

    <div class="cat-meta-bar">
      <span class="count-badge">{tools.length} herramientas disponibles</span>
      <div class="cat-search-wrap">
        <Icon name="search" size={16} class="search-ico" />
        <input 
          type="text" 
          id="cat-tool-search" 
          placeholder={`Buscar en ${category.name}...`} 
          autocomplete="off"
        />
      </div>
    </div>
  </div>

  <section class="panel-section">
    <div class="grid" id="cat-tools-grid">
      {tools.map((t) => (
        <div class="tool-card-wrap" data-name={t.name.toLowerCase()} data-desc={t.desc.toLowerCase()}>
          <a class="tool-card is-ready" href={t.href}>
            <div class="card-top">
              <div class="tool-icon">
                <Icon name={t.icon} size={22} />
              </div>
            </div>
            <div class="tool-content">
              <strong>{t.name}</strong>
              <span>{t.desc}</span>
            </div>
            <div class="tool-action">
              <span>Abrir herramienta</span>
              <Icon name="arrow-right" size={16} />
            </div>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Navegación a otras categorías -->
  <section class="other-categories-section">
    <h3>Explorar otras categorías</h3>
    <div class="other-cats-grid">
      {otherCategories.map((c) => (
        <a href={`/categoria/${c.id}`} class="other-cat-card">
          <div class="other-cat-icon">
            <Icon name={c.icon} size={20} />
          </div>
          <div>
            <strong>{c.name}</strong>
            <span class="count-sub">{ALL_TOOLS.filter(t => t.category === c.id).length} herramientas</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .breadcrumb a {
    color: var(--muted);
  }
  .breadcrumb a:hover {
    color: var(--accent);
  }

  .cat-page-header {
    margin-bottom: 2.5rem;
  }

  .header-main-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 600px) {
    .header-main-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .cat-page-icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    background: var(--surface-card);
    border: 2px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
  }

  .cat-page-header h1 {
    font-size: 2rem;
    margin: 0 0 0.35rem 0;
    letter-spacing: -0.02em;
  }

  .cat-page-header .lead {
    font-size: 1.05rem;
    color: var(--muted);
    margin: 0;
    max-width: 65ch;
  }

  .cat-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    background: var(--surface-card);
    border: 1px solid var(--line);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
  }

  .count-badge {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink);
  }

  .cat-search-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    width: 280px;
    max-width: 100%;
  }

  .cat-search-wrap :global(.search-ico) {
    position: absolute;
    left: 0.75rem;
    color: var(--muted);
    pointer-events: none;
  }

  #cat-tool-search {
    width: 100%;
    padding: 0.45rem 0.75rem 0.45rem 2.2rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 9999px;
    font-size: 0.85rem;
    color: var(--ink);
  }

  #cat-tool-search:focus {
    outline: none;
    border-color: var(--accent);
  }

  .card-top {
    margin-bottom: 0.75rem;
  }

  .other-categories-section {
    margin-top: 3.5rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  .other-categories-section h3 {
    font-size: 1.15rem;
    margin-bottom: 1.25rem;
  }

  .other-cats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.85rem;
  }

  .other-cat-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: var(--surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    transition: all 0.15s ease;
  }

  .other-cat-card:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .other-cat-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--bg);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
  }

  .other-cat-card strong {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .count-sub {
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>

<script>
  const search = document.getElementById('cat-tool-search') as HTMLInputElement;
  const cards = document.querySelectorAll<HTMLElement>('#cat-tools-grid .tool-card-wrap');

  if (search) {
    search.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      cards.forEach((card) => {
        const name = card.dataset.name || '';
        const desc = card.dataset.desc || '';
        if (!q || name.includes(q) || desc.includes(q)) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }
</script>
