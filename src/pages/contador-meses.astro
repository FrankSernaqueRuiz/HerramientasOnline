---
import Base from '../layouts/Base.astro';
---
<Base
  title="Calculadora de Fechas y Días Festivos"
  description="Calcula el desglose exacto de meses, semanas y días entre dos fechas, o consulta la cuenta regresiva para festividades."
>
  <div class="page-header">
    <h1>Calculadora de fechas</h1>
    <p class="lead">Calcula el tiempo exacto entre dos fechas o consulta cuánto resta para las festividades del año.</p>
  </div>

  <!-- Calculadora personalizada de fechas (Ahora arriba) -->
  <section class="panel">
    <h2>Calcular entre dos fechas</h2>
    <div class="date-inputs">
      <div class="field">
        <label for="date-start">Fecha inicial:</label>
        <input type="date" id="date-start" />
      </div>
      <div class="field">
        <label for="date-end">Fecha final:</label>
        <input type="date" id="date-end" />
      </div>
    </div>

    <div class="quick-presets">
      <span>Accesos directos:</span>
      <button type="button" data-preset="start-of-year">Inicio del año a hoy</button>
      <button type="button" data-preset="today-to-end-of-year">Hoy a fin de año</button>
      <button type="button" data-preset="last-month">Último mes</button>
    </div>

    <div class="stats" aria-live="polite">
      <div><b id="res-months">0</b><small>Meses aprox.</small></div>
      <div><b id="res-total-days">0</b><small>Días totales</small></div>
      <div><b id="res-weeks">0</b><small>Semanas y días</small></div>
      <div><b id="res-breakdown">0a 0m 0d</b><small>Años, meses y días</small></div>
    </div>

    <div id="human-text" class="summary-text">
      Selecciona dos fechas para ver el desglose detallado.
    </div>
  </section>

  <!-- Sección de Próximas Festividades (Compacta y en una sola fila) -->
  <section class="panel holidays-panel" style="margin-top: 1.5rem;">
    <div class="holidays-header">
      <h2>Próximas festividades</h2>
      <span class="holidays-hint">Haz clic en una fecha para calcular</span>
    </div>
    <div class="holidays-row" id="holidays-container"></div>
  </section>

  <section class="seo-section">
    <h2>Utilidad del cálculo de fechas</h2>
    <p>Permite determinar con exactitud plazos de proyectos, vencimientos de contratos de arrendamiento, antigüedad laboral o planificar eventos y vacaciones.</p>
  </section>
</Base>

<style>
  .holidays-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .holidays-header h2 {
    margin: 0;
    font-size: 1.05rem;
  }
  .holidays-hint {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .holidays-row {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }
  :global(.holiday-mini-card) {
    flex: 1 1 0;
    min-width: 125px;
    background: var(--surface-card);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.65rem;
    border: 1px solid var(--line);
    cursor: pointer;
    transition: border-color 0.15s, transform 0.15s;
    user-select: none;
    text-align: center;
    white-space: nowrap;
  }
  :global(.holiday-mini-card:hover) {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  :global(.holiday-mini-card .h-top) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.84rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
  }
  :global(.holiday-mini-card .h-emoji) {
    font-size: 1rem;
    line-height: 1;
  }
  :global(.holiday-mini-card .h-countdown) {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.88rem;
    line-height: 1.2;
  }
  :global(.holiday-mini-card .h-date) {
    display: block;
    color: var(--muted);
    font-size: 0.74rem;
    margin-top: 0.15rem;
  }

  .date-inputs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.2rem;
    margin-bottom: 1.2rem;
  }
  .field label {
    display: block;
    margin-bottom: 0.4rem;
    font-weight: 500;
    font-size: 0.92rem;
  }
  .field input[type="date"] {
    width: 100%;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
  }
  .quick-presets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .quick-presets span {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .summary-text {
    background: var(--surface-card);
    padding: 1rem 1.2rem;
    border-radius: var(--radius-sm);
    font-size: 1rem;
    border-left: 3px solid var(--accent);
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
</style>

<script>
  const holidays = [
    { name: 'Halloween', emoji: '🎃', month: 10, day: 31 },
    { name: 'Navidad', emoji: '🎄', month: 12, day: 25 },
    { name: 'Fin de Año', emoji: '🎆', month: 12, day: 31 },
    { name: 'Año Nuevo', emoji: '🥂', month: 1, day: 1 },
    { name: 'San Valentín', emoji: '💘', month: 2, day: 14 }
  ];

  const holidaysContainer = document.getElementById('holidays-container')!;
  const startInput = document.getElementById('date-start') as HTMLInputElement;
  const endInput = document.getElementById('date-end') as HTMLInputElement;

  const resMonths = document.getElementById('res-months')!;
  const resTotalDays = document.getElementById('res-total-days')!;
  const resWeeks = document.getElementById('res-weeks')!;
  const resBreakdown = document.getElementById('res-breakdown')!;
  const humanText = document.getElementById('human-text')!;

  function getNextHolidayDate(month: number, day: number): Date {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    let target = new Date(today.getFullYear(), month - 1, day);
    if (target.getTime() < today.getTime()) {
      target = new Date(today.getFullYear() + 1, month - 1, day);
    }
    return target;
  }

  function renderHolidays() {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    holidaysContainer.innerHTML = '';

    holidays.forEach(h => {
      const target = getNextHolidayDate(h.month, h.day);
      const diffDays = Math.ceil((target.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));

      const card = document.createElement('div');
      card.className = 'holiday-mini-card';
      const targetIso = target.toISOString().split('T')[0];
      const todayIso = today.toISOString().split('T')[0];

      card.innerHTML = `
        <div class="h-top">
          <span class="h-emoji">${h.emoji}</span>
          <span>${h.name}</span>
        </div>
        <div class="h-countdown">${diffDays === 0 ? 'Hoy' : (diffDays === 1 ? 'Mañana' : `${diffDays} días`)}</div>
        <span class="h-date">${target.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}</span>
      `;

      card.addEventListener('click', () => {
        startInput.value = todayIso;
        endInput.value = targetIso;
        calculateDiff();
        startInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      holidaysContainer.appendChild(card);
    });
  }

  const now = new Date();
  const todayStr = now.toISOString().split('T')[0];
  const nextChristmas = getNextHolidayDate(12, 25).toISOString().split('T')[0];

  startInput.value = todayStr;
  endInput.value = nextChristmas;

  function calculateDiff() {
    if (!startInput.value || !endInput.value) return;

    let d1 = new Date(startInput.value + 'T00:00:00');
    let d2 = new Date(endInput.value + 'T00:00:00');

    if (d1 > d2) {
      const temp = d1;
      d1 = d2;
      d2 = temp;
    }

    const diffMs = Math.abs(d2.getTime() - d1.getTime());
    const totalDays = Math.round(diffMs / (1000 * 60 * 60 * 24));

    let from = new Date(d1);
    const to = new Date(d2);

    let years = to.getFullYear() - from.getFullYear();
    let months = to.getMonth() - from.getMonth();
    let days = to.getDate() - from.getDate();

    if (days < 0) {
      months--;
      const prevMonthLastDay = new Date(to.getFullYear(), to.getMonth(), 0).getDate();
      days += prevMonthLastDay;
    }
    if (months < 0) {
      years--;
      months += 12;
    }

    const totalMonths = (years * 12) + months + (days > 0 ? Number((days / 30.4375).toFixed(1)) : 0);
    const weeks = Math.floor(totalDays / 7);
    const remDays = totalDays % 7;

    resMonths.textContent = String(totalMonths);
    resTotalDays.textContent = String(totalDays);
    resWeeks.textContent = `${weeks}s ${remDays}d`;
    resBreakdown.textContent = `${years}a ${months}m ${days}d`;

    humanText.textContent = `Entre ambas fechas hay ${years > 0 ? years + ' año(s), ' : ''}${months} mes(es) y ${days} día(s). En total son ${totalDays.toLocaleString()} días (${totalMonths} meses).`;
  }

  document.querySelectorAll<HTMLButtonElement>('button[data-preset]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const preset = btn.dataset.preset;
      const current = new Date();
      if (preset === 'start-of-year') {
        startInput.value = `${current.getFullYear()}-01-01`;
        endInput.value = current.toISOString().split('T')[0];
      } else if (preset === 'today-to-end-of-year') {
        startInput.value = current.toISOString().split('T')[0];
        endInput.value = `${current.getFullYear()}-12-31`;
      } else if (preset === 'last-month') {
        const lastM = new Date(current.getFullYear(), current.getMonth() - 1, current.getDate());
        startInput.value = lastM.toISOString().split('T')[0];
        endInput.value = current.toISOString().split('T')[0];
      }
      calculateDiff();
    });
  });

  startInput.addEventListener('change', calculateDiff);
  endInput.addEventListener('change', calculateDiff);

  renderHolidays();
  calculateDiff();
</script>
