---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Sorteador para Redes Sociales – Sorteo Online Aleatorio" description="Pega la lista de participantes, elige cuántos ganadores y sortea al azar con tarjeta visual lista para captura.">
  <div class="page-header">
    <div class="breadcrumb"><a href="/">Herramientas</a> / <span>Sorteos y diversión</span></div>
    <h1>Sorteador para Redes Sociales</h1>
    <p class="lead">Pega nombres o usuarios (uno por línea), define cuántos ganadores necesitas y sortea con animación. El resultado queda listo para compartir como captura de pantalla.</p>
  </div>

  <section class="panel">
    <div class="sorteo-grid">
      <div class="input-side">
        <label for="participants">Participantes (uno por línea):</label>
        <textarea id="participants" rows="12" placeholder="@usuario1&#10;@usuario2&#10;Juan Pérez&#10;María López&#10;..."></textarea>
        <div class="meta-row">
          <span id="participant-count">0 participantes</span>
          <button type="button" id="btn-load-demo" class="btn-text">Cargar ejemplo</button>
        </div>

        <div class="config-row">
          <div class="field-sm">
            <label for="winner-count">Ganadores:</label>
            <input type="number" id="winner-count" min="1" max="100" value="1" />
          </div>
          <div class="field-sm">
            <label for="anim-duration">Duración animación:</label>
            <select id="anim-duration" class="select-anim">
              <option value="2000" selected>2 segundos (Recomendado)</option>
              <option value="3000">3 segundos (Normal)</option>
              <option value="5000">5 segundos (Suspenso)</option>
              <option value="8000">8 segundos (Máxima emoción)</option>
              <option value="0">0 segundos (Instantáneo)</option>
            </select>
          </div>
          <div class="field-sm field-checkbox">
            <label for="allow-dupes">
              <input type="checkbox" id="allow-dupes" /> Permitir repetidos
            </label>
          </div>
        </div>

        <button type="button" id="btn-sortear" class="btn-primary btn-lg">
          <Icon name="gift" size={18} /> ¡Sortear ahora!
        </button>
      </div>

      <div class="result-side">
        <!-- Caja animada de revoleteo / ruleta -->
        <div id="shuffling-box" class="shuffling-box hidden">
          <div class="shuffling-badge">🎲 REVOLOTEANDO PARTICIPANTES...</div>
          <div class="shuffling-display">
            <span class="shuffle-sparkle">✨</span>
            <div id="shuffling-name" class="shuffling-name">@participante</div>
            <span class="shuffle-sparkle">✨</span>
          </div>
          <div class="shuffling-progress-track">
            <div id="shuffling-progress-bar" class="shuffling-progress-bar"></div>
          </div>
          <p class="shuffling-subtext">Seleccionando con aleatoriedad criptográfica...</p>
        </div>

        <div id="result-card" class="result-card hidden">
          <div class="card-header">
            <span class="card-badge">🎉 RESULTADO DEL SORTEO</span>
          </div>
          <div id="winners-list" class="winners-list"></div>
          <div class="card-footer">
            <span id="card-meta"></span>
          </div>
        </div>

        <div id="placeholder-msg" class="placeholder-msg">
          <Icon name="gift" size={40} />
          <p>Agrega participantes y presiona <strong>¡Sortear!</strong></p>
        </div>

        <div class="result-actions">
          <button type="button" id="btn-copy-winners" class="btn-secondary hidden">
            <Icon name="copy" size={15} /> Copiar ganadores
          </button>
          <button type="button" id="btn-reset" class="btn-outline hidden">Nuevo sorteo</button>
        </div>
      </div>
    </div>
  </section>

  <section class="seo-section">
    <h2>Sorteos transparentes y rápidos</h2>
    <p>Ideal para concursos en Instagram, TikTok o YouTube. Toda la selección ocurre en tu navegador con <code>crypto.getRandomValues</code> para garantizar aleatoriedad criptográfica.</p>
  </section>
</Base>

<style>
  .breadcrumb{font-size:.85rem;color:var(--muted);margin-bottom:.5rem}.breadcrumb a{color:var(--muted)}
  .sorteo-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}
  @media(max-width:768px){.sorteo-grid{grid-template-columns:1fr}}
  .input-side label{display:block;font-weight:600;font-size:.9rem;margin-bottom:.4rem}
  .meta-row{display:flex;justify-content:space-between;font-size:.82rem;color:var(--muted);margin:.4rem 0 1rem}
  .btn-text{background:none;border:none;color:var(--accent);cursor:pointer;font-size:.82rem;padding:0}
  .config-row{display:flex;gap:1.25rem;align-items:end;margin-bottom:1.25rem;flex-wrap:wrap}
  .field-sm label{display:block;font-size:.85rem;font-weight:500;margin-bottom:.3rem}
  .field-sm input[type="number"]{width:80px;padding:.5rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font:inherit}
  .select-anim{padding:.5rem .75rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font:inherit;font-size:.85rem}
  .field-checkbox{display:flex;align-items:center;padding-bottom:.5rem}
  .field-checkbox label{display:inline-flex;align-items:center;gap:.4rem;cursor:pointer;font-size:.85rem;margin-bottom:0}
  .btn-primary{background:var(--accent);color:var(--accent-ink);border:none;border-radius:var(--radius-sm);padding:.7rem 1.4rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font-size:1rem;transition:all .18s ease}
  .btn-primary:hover:not(:disabled){transform:translateY(-1px);filter:brightness(1.08)}
  .btn-primary:disabled{opacity:.7;cursor:not-allowed}
  .btn-lg{width:100%}
  .result-actions{display:flex;gap:.75rem;margin-top:1rem;flex-wrap:wrap}
  .btn-secondary{background:var(--surface);border:1px solid var(--line);color:var(--ink);border-radius:var(--radius-sm);padding:.6rem 1.2rem;font-weight:600;cursor:pointer;flex:1;display:inline-flex;align-items:center;justify-content:center;gap:.4rem;font-size:.9rem;transition:all .15s}
  .btn-secondary:hover{background:var(--surface-hover);border-color:var(--accent)}
  .btn-outline{background:transparent;border:1px solid var(--line);color:var(--muted);border-radius:var(--radius-sm);padding:.6rem 1.2rem;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;font-size:.9rem;transition:all .15s}
  .btn-outline:hover{color:var(--ink);border-color:var(--ink)}

  /* Animación de revoleteo / suspenso */
  .shuffling-box{
    background:linear-gradient(135deg,#131622,#1b2238);
    border:2px dashed #e2b714;
    border-radius:var(--radius-md);
    padding:2.2rem 1.5rem;
    text-align:center;
    color:#f0f6fc;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    min-height:280px;
    box-shadow:0 10px 30px rgba(226,183,20,0.15);
    animation:pulseBorder 1.2s infinite alternate ease-in-out;
  }
  @keyframes pulseBorder{
    from{border-color:#e2b714;box-shadow:0 0 15px rgba(226,183,20,0.2)}
    to{border-color:#ffd13b;box-shadow:0 0 30px rgba(226,183,20,0.45)}
  }
  .shuffling-badge{
    background:rgba(226,183,20,0.15);
    border:1px solid rgba(226,183,20,0.4);
    color:#ffd13b;
    padding:.35rem .9rem;
    border-radius:9999px;
    font-size:.78rem;
    font-weight:800;
    letter-spacing:.05em;
    margin-bottom:1.5rem;
  }
  .shuffling-display{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:.75rem;
    width:100%;
    margin-bottom:1.5rem;
  }
  .shuffle-sparkle{
    font-size:1.3rem;
    animation:spinSparkle 1s infinite ease-in-out;
  }
  @keyframes spinSparkle{
    0%,100%{transform:scale(1) rotate(0deg)}
    50%{transform:scale(1.3) rotate(25deg)}
  }
  .shuffling-name{
    font-size:1.5rem;
    font-weight:800;
    color:#ffffff;
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.18);
    border-radius:var(--radius-sm);
    padding:.75rem 1.3rem;
    max-width:320px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    text-shadow:0 0 12px rgba(226,183,20,.6);
    transition:transform .04s ease;
  }
  .shuffling-progress-track{
    width:100%;
    max-width:280px;
    height:6px;
    background:rgba(255,255,255,.1);
    border-radius:9999px;
    overflow:hidden;
    margin-bottom:.75rem;
  }
  .shuffling-progress-bar{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,#e2b714,#38ef7d);
    border-radius:9999px;
    transition:width .05s linear;
  }
  .shuffling-subtext{
    font-size:.8rem;
    color:rgba(255,255,255,.6);
    margin:0;
  }

  /* Tarjeta de Ganador con Confeti */
  .result-card{
    background:linear-gradient(135deg,#1a1a2e,#16213e);
    border:2px solid #e2b714;
    border-radius:var(--radius-md);
    padding:2rem;
    text-align:center;
    color:#f0f6fc;
    position:relative;
    overflow:hidden;
    box-shadow:0 12px 35px rgba(0,0,0,0.3);
    animation:cardScalePop .35s cubic-bezier(0.16,1,0.3,1);
  }
  @keyframes cardScalePop{
    from{opacity:0;transform:scale(0.92)}
    to{opacity:1;transform:scale(1)}
  }
  .card-header{margin-bottom:1.5rem}
  .card-badge{background:#e2b714;color:#1a1a2e;padding:.35rem .95rem;border-radius:9999px;font-size:.78rem;font-weight:800;letter-spacing:.06em}
  .winners-list{display:flex;flex-direction:column;gap:.75rem;margin-bottom:1.5rem}
  :global(.winner-item){background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:var(--radius-sm);padding:.85rem 1rem;font-size:1.15rem;font-weight:700;display:flex;align-items:center;gap:.75rem;animation:fadeSlide .4s ease both}
  :global(.winner-pos){background:#e2b714;color:#1a1a2e;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.85rem;font-weight:800;flex-shrink:0}
  @keyframes fadeSlide{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
  .card-footer{font-size:.78rem;color:rgba(255,255,255,.6)}
  .placeholder-msg{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:260px;color:var(--muted);text-align:center;gap:.75rem}
  .hidden{display:none!important}

  /* Confeti CSS */
  :global(.confetti-flake){
    position:absolute;
    width:8px;
    height:12px;
    background:var(--c);
    border-radius:2px;
    pointer-events:none;
    z-index:10;
    animation:confettiFall 1.6s cubic-bezier(0.25,1,0.5,1) forwards;
  }
  @keyframes confettiFall{
    0%{opacity:1;transform:translate(0,0) rotate(0deg) scale(1)}
    100%{opacity:0;transform:translate(var(--x),280px) rotate(var(--r)) scale(0.6)}
  }
</style>

<script>
  const ta = document.getElementById('participants') as HTMLTextAreaElement;
  const countEl = document.getElementById('participant-count')!;
  const winnerInput = document.getElementById('winner-count') as HTMLInputElement;
  const durationSelect = document.getElementById('anim-duration') as HTMLSelectElement;
  const btnSortear = document.getElementById('btn-sortear') as HTMLButtonElement;
  const btnReset = document.getElementById('btn-reset') as HTMLButtonElement;
  const btnCopyWinners = document.getElementById('btn-copy-winners') as HTMLButtonElement;
  const btnDemo = document.getElementById('btn-load-demo')!;
  const resultCard = document.getElementById('result-card')!;
  const winnersList = document.getElementById('winners-list')!;
  const placeholder = document.getElementById('placeholder-msg')!;
  const cardMeta = document.getElementById('card-meta')!;
  const allowDupes = document.getElementById('allow-dupes') as HTMLInputElement;

  // Elementos de animación
  const shufflingBox = document.getElementById('shuffling-box')!;
  const shufflingName = document.getElementById('shuffling-name')!;
  const progressBar = document.getElementById('shuffling-progress-bar')!;

  let currentWinners: string[] = [];
  let shuffleAnimationId: number | null = null;

  function getList(): string[] {
    return ta.value.split('\n').map((l) => l.trim()).filter(Boolean);
  }

  ta.addEventListener('input', () => {
    countEl.textContent = `${getList().length} participantes`;
  });

  btnDemo.addEventListener('click', () => {
    ta.value = '@maria_glez\n@juandev\n@carla.fit\n@pedrotech\n@luciana_art\n@andres_vibes\n@sofi.bloom\n@marcos_chef\n@vale_travel\n@nico_gamer';
    ta.dispatchEvent(new Event('input'));
  });

  function secureRandom(max: number): number {
    const a = new Uint32Array(1);
    crypto.getRandomValues(a);
    return a[0] % max;
  }

  // Fallback clipboard
  async function copyText(text: string): Promise<boolean> {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {}

    try {
      const textArea = document.createElement('textarea');
      textArea.value = text;
      textArea.style.position = 'fixed';
      textArea.style.left = '-9999px';
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      const success = document.execCommand('copy');
      document.body.removeChild(textArea);
      return success;
    } catch {
      return false;
    }
  }

  function fireConfetti() {
    const colors = ['#e2b714', '#38ef7d', '#11998e', '#ff4b2b', '#ff416c', '#00b4d8', '#7928ca', '#ffd13b'];
    for (let i = 0; i < 35; i++) {
      const flake = document.createElement('div');
      flake.className = 'confetti-flake';
      flake.style.setProperty('--c', colors[Math.floor(Math.random() * colors.length)]);
      flake.style.setProperty('--x', `${(Math.random() - 0.5) * 340}px`);
      flake.style.setProperty('--r', `${Math.random() * 360}deg`);
      flake.style.left = `${Math.random() * 80 + 10}%`;
      flake.style.top = '25%';
      resultCard.appendChild(flake);
      setTimeout(() => flake.remove(), 1700);
    }
  }

  function displayWinners(winners: string[], totalCount: number) {
    currentWinners = winners;
    winnersList.innerHTML = '';
    winners.forEach((w, i) => {
      const div = document.createElement('div');
      div.className = 'winner-item';
      div.style.animationDelay = `${i * 0.12}s`;
      div.innerHTML = `<span class="winner-pos">${i + 1}</span><span>${w}</span>`;
      winnersList.appendChild(div);
    });

    const now = new Date();
    cardMeta.textContent = `${totalCount} participantes · ${now.toLocaleDateString('es')} ${now.toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit' })}`;

    resultCard.classList.remove('hidden');
    placeholder.classList.add('hidden');
    btnReset.classList.remove('hidden');
    btnCopyWinners.classList.remove('hidden');
  }

  function stopAnimation() {
    if (shuffleAnimationId !== null) {
      cancelAnimationFrame(shuffleAnimationId);
      shuffleAnimationId = null;
    }
  }

  btnSortear.addEventListener('click', () => {
    const list = getList();
    if (!list.length) {
      alert('Por favor ingresa al menos un participante.');
      ta.focus();
      return;
    }

    const num = Math.min(parseInt(winnerInput.value) || 1, allowDupes.checked ? 999 : list.length);
    const duration = parseInt(durationSelect.value) || 0;

    // Calcular ganadores de antemano con aleatoriedad criptográfica
    const winners: string[] = [];
    const pool = [...list];
    for (let i = 0; i < num; i++) {
      if (!pool.length) break;
      const idx = secureRandom(pool.length);
      winners.push(pool[idx]);
      if (!allowDupes.checked) pool.splice(idx, 1);
    }

    // Detener animaciones previas si hubiera
    stopAnimation();

    if (duration === 0) {
      shufflingBox.classList.add('hidden');
      displayWinners(winners, list.length);
      fireConfetti();
      return;
    }

    // Preparar estado de animación
    placeholder.classList.add('hidden');
    resultCard.classList.add('hidden');
    btnReset.classList.add('hidden');
    btnCopyWinners.classList.add('hidden');
    shufflingBox.classList.remove('hidden');

    btnSortear.disabled = true;
    btnSortear.textContent = '🎲 Sorteando ganador...';

    const startTime = performance.now();
    let lastUpdate = 0;
    let currentInterval = 40;

    function animate(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      progressBar.style.width = `${progress * 100}%`;

      // Desaceleración progresiva (slot-machine tension): el intervalo aumenta de 40ms a 240ms hacia el final
      currentInterval = 40 + Math.pow(progress, 2.5) * 200;

      if (now - lastUpdate >= currentInterval) {
        lastUpdate = now;
        const randomParticipant = list[Math.floor(Math.random() * list.length)];
        shufflingName.textContent = randomParticipant;
        shufflingName.style.transform = 'scale(1.05)';
        setTimeout(() => {
          shufflingName.style.transform = 'scale(1)';
        }, 30);
      }

      if (elapsed < duration) {
        shuffleAnimationId = requestAnimationFrame(animate);
      } else {
        stopAnimation();
        shufflingBox.classList.add('hidden');
        displayWinners(winners, list.length);
        fireConfetti();
        btnSortear.disabled = false;
        btnSortear.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg> ¡Sortear ahora!`;
      }
    }

    shuffleAnimationId = requestAnimationFrame(animate);
  });

  btnCopyWinners.addEventListener('click', async () => {
    if (!currentWinners.length) return;
    const text = currentWinners.map((w, i) => `${i + 1}. ${w}`).join('\n');
    const ok = await copyText(text);
    if (ok) {
      btnCopyWinners.textContent = '✓ ¡Copiados!';
      setTimeout(() => {
        btnCopyWinners.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> Copiar ganadores`;
      }, 2000);
    }
  });

  btnReset.addEventListener('click', () => {
    stopAnimation();
    resultCard.classList.add('hidden');
    shufflingBox.classList.add('hidden');
    placeholder.classList.remove('hidden');
    btnReset.classList.add('hidden');
    btnCopyWinners.classList.add('hidden');
    btnSortear.disabled = false;
    btnSortear.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg> ¡Sortear ahora!`;
  });
</script>
