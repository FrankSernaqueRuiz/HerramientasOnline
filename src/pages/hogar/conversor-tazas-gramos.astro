---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Conversor de Tazas a Gramos y Mililitros para Cocina y Repostería" description="Convierte tazas, gramos, cucharadas y mililitros según la densidad real de cada ingrediente (harina, azúcar, mantequilla, avena y más).">
  <div class="page-header">
    <div class="breadcrumb"><a href="/">Herramientas</a> / <span>Hogar y vida diaria</span></div>
    <h1>Conversor de Tazas a Gramos</h1>
    <p class="lead">En repostería, una taza de harina no pesa lo mismo que una taza de azúcar. Convierte con precisión según la densidad exacta de cada alimento.</p>
  </div>

  <section class="panel">
    <div class="converter-box">
      <div class="field">
        <label for="food-select">Selecciona el ingrediente:</label>
        <select id="food-select" class="form-input">
          <option value="120|Harina de trigo común">Harina de trigo de todo uso (1 taza = 120g)</option>
          <option value="200|Azúcar blanca normal">Azúcar blanca refinada (1 taza = 200g)</option>
          <option value="220|Azúcar moreno / mascabado">Azúcar moreno / mascabado (1 taza = 220g)</option>
          <option value="120|Azúcar glas / impalpable">Azúcar flor / glas (1 taza = 120g)</option>
          <option value="225|Mantequilla">Mantequilla / Margarina (1 taza = 225g)</option>
          <option value="100|Cacao puro en polvo">Cacao puro en polvo (1 taza = 100g)</option>
          <option value="90|Avena en copos">Avena tradicional en copos (1 taza = 90g)</option>
          <option value="220|Aceite vegetal">Aceite de oliva o girasol (1 taza = 220g)</option>
          <option value="340|Miel de abeja">Miel de abeja o sirope de arce (1 taza = 340g)</option>
          <option value="110|Maicena / Fécula">Maicena / Fécula de maíz (1 taza = 110g)</option>
          <option value="185|Arroz blanco crudo">Arroz blanco crudo (1 taza = 185g)</option>
          <option value="240|Leche o Agua">Leche / Agua (1 taza = 240g = 240ml)</option>
        </select>
      </div>

      <div class="conversion-interactive-grid">
        <div class="conv-col">
          <label for="input-cups">Medida en Tazas (Cups):</label>
          <div class="input-with-buttons">
            <input type="number" id="input-cups" value="1" step="0.25" min="0" class="conv-number-input" />
            <div class="quick-fractions">
              <button type="button" class="btn-frac" data-val="0.25">¼</button>
              <button type="button" class="btn-frac" data-val="0.33">⅓</button>
              <button type="button" class="btn-frac" data-val="0.5">½</button>
              <button type="button" class="btn-frac" data-val="0.75">¾</button>
              <button type="button" class="btn-frac" data-val="1">1</button>
            </div>
          </div>
        </div>

        <div class="conv-arrow">⇄</div>

        <div class="conv-col">
          <label for="input-grams">Peso en Gramos (g):</label>
          <input type="number" id="input-grams" value="120" step="5" min="0" class="conv-number-input" />
        </div>
      </div>

      <!-- Extra equivalents -->
      <div class="equivalents-ribbon">
        <div class="eq-item">🥄 Cucharadas soperas: <strong id="eq-tbsp">8 cdas</strong></div>
        <div class="eq-item">🥄 Cucharaditas (teaspoon): <strong id="eq-tsp">24 cdtas</strong></div>
        <div class="eq-item">⚖️ En Onzas (oz): <strong id="eq-oz">4.23 oz</strong></div>
      </div>
    </div>

    <!-- Reference Cheat Sheet Table -->
    <div class="cheatsheet-section">
      <h3>Tabla rápida de equivalencias (1 Taza estándar)</h3>
      <div class="table-responsive">
        <table class="cheat-table">
          <thead>
            <tr>
              <th>Ingrediente</th>
              <th>1 Taza</th>
              <th>¾ Taza</th>
              <th>½ Taza</th>
              <th>¼ Taza</th>
              <th>1 Cucharada</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Harina de trigo</td>
              <td>120 g</td>
              <td>90 g</td>
              <td>60 g</td>
              <td>30 g</td>
              <td>10 g</td>
            </tr>
            <tr>
              <td>Azúcar blanca</td>
              <td>200 g</td>
              <td>150 g</td>
              <td>100 g</td>
              <td>50 g</td>
              <td>15 g</td>
            </tr>
            <tr>
              <td>Mantequilla</td>
              <td>225 g</td>
              <td>170 g</td>
              <td>115 g</td>
              <td>55 g</td>
              <td>15 g</td>
            </tr>
            <tr>
              <td>Cacao en polvo</td>
              <td>100 g</td>
              <td>75 g</td>
              <td>50 g</td>
              <td>25 g</td>
              <td>7 g</td>
            </tr>
            <tr>
              <td>Avena en hojuelas</td>
              <td>90 g</td>
              <td>68 g</td>
              <td>45 g</td>
              <td>22 g</td>
              <td>6 g</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="seo-section">
    <h2>¿Por qué una taza no pesa siempre lo mismo y cómo funciona el conversor?</h2>
    <p>El error más habitual en repostería es asumir que una taza equivale siempre a la misma cantidad de gramos. <strong>La taza es una unidad de volumen</strong> (aproximadamente 240 ml en el estándar métrico/estadounidense), mientras que <strong>el gramo es una unidad de masa o peso</strong>. Una taza de harina de trigo pesa alrededor de 120 gramos porque es un polvo aireado, mientras que esa misma taza llena de azúcar blanco pesa 200 gramos y de mantequilla 225 gramos debido a sus diferentes densidades.</p>

    <div class="step-list">
      <div class="step-card">
        <span class="step-num">1</span>
        <div class="step-body">
          <h4>Selecciona el ingrediente específico de tu receta</h4>
          <p>Elige entre harinas, azúcares (blanco, moreno, impalpable), mantequilla, cacao, avena, líquidos o arroz.</p>
        </div>
      </div>
      <div class="step-card">
        <span class="step-num">2</span>
        <div class="step-body">
          <h4>Escribe en tazas o usa los botones rápidos (¼, ⅓, ½, ¾)</h4>
          <p>Introduce la fracción o número de tazas indicado en la receta en inglés o tradicional.</p>
        </div>
      </div>
      <div class="step-card">
        <span class="step-num">3</span>
        <div class="step-body">
          <h4>Obtén el peso exacto en gramos, onzas y cucharadas</h4>
          <p>Pesa con total precisión en tu báscula de cocina digital para garantizar que tus postres queden perfectos.</p>
        </div>
      </div>
    </div>

    <h3>Casos de uso en pastelería y cocina internacional</h3>
    <div class="guide-grid">
      <div class="guide-card">
        <h4>Recetas de repostería en inglés (US Cups)</h4>
        <p>Adapta fácilmente recetas virales de TikTok, YouTube o blogs anglosajones que usan "cups" y "tablespoons".</p>
      </div>
      <div class="guide-card">
        <h4>Pastelería profesional con báscula de precisión</h4>
        <p>Evita bizcochos secos o galletas duras pesando en gramos en vez de depender del volumen impreciso de las tazas de café.</p>
      </div>
      <div class="guide-card">
        <h4>Cocina cotidiana sin balanza de cocina</h4>
        <p>Convierte a la inversa: si una receta pide 150g de azúcar y no tienes báscula, averigua cuántas tazas o cucharadas necesitas.</p>
      </div>
    </div>

    <h2>Preguntas frecuentes sobre tazas y gramos</h2>
    <div class="faq-wrap">
      <div class="faq-item">
        <div class="faq-question">¿Cuántos mililitros tiene una taza estándar de cocina?</div>
        <div class="faq-answer">
          <p>En repostería internacional estándar (US Legal Cup y Latinoamérica), una taza equivale a <strong>240 ml</strong> (o 250 ml en el sistema métrico australiano/europeo). Esta equivalencia de 1:1 en gramos solo aplica para el agua pura (1 taza de agua = 240 gramos).</p>
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-question">¿Cómo se debe medir la harina en una taza para que no pese de más?</div>
        <div class="faq-answer">
          <p>Nunca compactes la harina presionándola con la taza dentro de la bolsa. El método correcto es airear la harina con un tenedor, verterla con una cuchara dentro de la taza medidora y enrasar el exceso superior con el lomo plano de un cuchillo.</p>
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-question">¿Cuántos gramos tiene una cucharada sopera (tbsp)?</div>
        <div class="faq-answer">
          <p>Una cucharada sopera rasa (15 ml) equivale a unos 15g de agua o leche, 12g de azúcar blanco, 8g de harina de trigo y 14g de mantequilla o aceite.</p>
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-question">¿Sirve cualquier taza de café o té de mi vajilla?</div>
        <div class="faq-answer">
          <p>No. Las tazas de vajilla doméstica (mugs) suelen variar enormemente entre 180 ml y 350 ml. Para cocinar con éxito debes usar tazas medidoras graduadas estándar o pesar en gramos con nuestra calculadora.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .breadcrumb{font-size:.85rem;color:var(--muted);margin-bottom:.5rem}.breadcrumb a{color:var(--muted)}
  .converter-box{background:var(--surface-card);border:1px solid var(--line);border-radius:var(--radius-sm);padding:1.5rem;margin-bottom:2rem}
  .field{margin-bottom:1.5rem}
  .field label{display:block;font-weight:600;font-size:.9rem;margin-bottom:.4rem}
  .form-input{width:100%;padding:.6rem .75rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font:inherit}

  .conversion-interactive-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:1.5rem;align-items:center;margin-bottom:1.5rem}
  @media(max-width:700px){.conversion-interactive-grid{grid-template-columns:1fr;text-align:center}.conv-arrow{transform:rotate(90deg);margin:0 auto}}
  .conv-col label{display:block;font-weight:700;font-size:.88rem;margin-bottom:.5rem}
  .conv-number-input{width:100%;padding:.75rem 1rem;font-size:1.8rem;font-weight:900;background:var(--bg);border:2px solid var(--line);border-radius:var(--radius-sm);color:var(--accent);text-align:center}
  .conv-number-input:focus{border-color:var(--accent);outline:none}
  .conv-arrow{font-size:2rem;font-weight:800;color:var(--muted)}

  .quick-fractions{display:flex;gap:.35rem;margin-top:.5rem;justify-content:center}
  .btn-frac{background:var(--bg);border:1px solid var(--line);padding:3px 8px;border-radius:4px;font-size:.82rem;font-weight:700;color:var(--ink);cursor:pointer}
  .btn-frac:hover{border-color:var(--accent);color:var(--accent)}

  .equivalents-ribbon{display:flex;gap:1.2rem;flex-wrap:wrap;background:var(--bg);padding:.8rem 1rem;border-radius:var(--radius-sm);border:1px solid var(--line);font-size:.88rem;justify-content:space-around}
  .eq-item strong{color:var(--ink)}

  .cheatsheet-section h3{font-size:1rem;margin-bottom:1rem}
  .table-responsive{overflow-x:auto}
  .cheat-table{width:100%;border-collapse:collapse}
  .cheat-table th{background:var(--surface-card);border:1px solid var(--line);padding:.6rem;font-size:.82rem;text-transform:uppercase;color:var(--muted);text-align:left}
  .cheat-table td{border:1px solid var(--line);padding:.55rem .6rem;font-size:.88rem}
</style>

<script>
  const foodSelect = document.getElementById('food-select') as HTMLSelectElement;
  const cupsInput = document.getElementById('input-cups') as HTMLInputElement;
  const gramsInput = document.getElementById('input-grams') as HTMLInputElement;
  const eqTbsp = document.getElementById('eq-tbsp')!;
  const eqTsp = document.getElementById('eq-tsp')!;
  const eqOz = document.getElementById('eq-oz')!;
  const fracBtns = document.querySelectorAll('.btn-frac');

  function getGramsPerCup(): number {
    const val = foodSelect.value;
    return parseFloat(val.split('|')[0]) || 120;
  }

  function updateFromCups() {
    const cups = parseFloat(cupsInput.value) || 0;
    const gPerCup = getGramsPerCup();
    const grams = cups * gPerCup;

    gramsInput.value = grams % 1 === 0 ? grams.toString() : grams.toFixed(1);

    // Equivalents
    const tbsp = (cups * 16).toFixed(1);
    const tsp = (cups * 48).toFixed(1);
    const oz = (grams * 0.035274).toFixed(2);

    eqTbsp.textContent = `${tbsp} cdas`;
    eqTsp.textContent = `${tsp} cdtas`;
    eqOz.textContent = `${oz} oz`;
  }

  function updateFromGrams() {
    const grams = parseFloat(gramsInput.value) || 0;
    const gPerCup = getGramsPerCup();
    const cups = grams / gPerCup;

    cupsInput.value = (Math.round(cups * 100) / 100).toString();

    const tbsp = (cups * 16).toFixed(1);
    const tsp = (cups * 48).toFixed(1);
    const oz = (grams * 0.035274).toFixed(2);

    eqTbsp.textContent = `${tbsp} cdas`;
    eqTsp.textContent = `${tsp} cdtas`;
    eqOz.textContent = `${oz} oz`;
  }

  foodSelect.addEventListener('change', updateFromCups);
  cupsInput.addEventListener('input', updateFromCups);
  gramsInput.addEventListener('input', updateFromGrams);

  fracBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const v = (e.currentTarget as HTMLElement).dataset.val || '1';
      cupsInput.value = v;
      updateFromCups();
    });
  });

  updateFromCups();
</script>
