<script>
  let activeCountry = 'pe';

  const formatCurrency = (val: number, cur: string = 'S/') => {
    return `${cur} ${val.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  };

  const calculateSueldo = () => {
    const sueldoBruto = parseFloat((document.getElementById('sueldo-bruto') as HTMLInputElement).value) || 0;

    if (activeCountry === 'pe') {
      const tieneAsig = (document.getElementById('asig-fam-sueldo') as HTMLInputElement).checked;
      const afpType = (document.getElementById('afp-select') as HTMLSelectElement).value;
      const uit = parseFloat((document.getElementById('uit-val') as HTMLInputElement).value) || 5350;
      const deducAdicional = parseFloat((document.getElementById('deduccion-adicional') as HTMLInputElement).value) || 0;

      const asig = tieneAsig ? 102.50 : 0;
      const computable = sueldoBruto + asig;

      // Tasas de pensión
      let tasaPension = 0;
      if (afpType === 'onp') tasaPension = 0.13;
      else if (afpType === 'prima') tasaPension = 0.10 + 0.014 + 0.0160;
      else if (afpType === 'integra') tasaPension = 0.10 + 0.014 + 0.0155;
      else if (afpType === 'profuturo') tasaPension = 0.10 + 0.014 + 0.0169;
      else if (afpType === 'habitat') tasaPension = 0.10 + 0.014 + 0.0147;
      else if (afpType === 'afp-mixta') tasaPension = 0.114;
      else tasaPension = 0;

      const montoPension = computable * tasaPension;

      // Cálculo Renta de 5ta Categoría:
      // Ingreso anual proyectado: (sueldo * 12) + (2 * sueldo * 1.09) gratificaciones con bonif
      const ingresoAnual = (computable * 12) + (2 * computable * 1.09);
      const deduccion7uit = 7 * uit;
      const deduccionTotal = deduccion7uit + Math.min(deducAdicional, 3 * uit);
      const rentaImponible = Math.max(0, ingresoAnual - deduccionTotal);

      // Tramos Sunat:
      // 0 a 5 UIT: 8%
      // 5 a 20 UIT: 14%
      // 20 a 35 UIT: 17%
      // 35 a 45 UIT: 20%
      // Mas de 45 UIT: 30%
      let impuestoAnual = 0;
      const tramo1 = 5 * uit;
      const tramo2 = 20 * uit;
      const tramo3 = 35 * uit;
      const tramo4 = 45 * uit;

      if (rentaImponible > 0) {
        const parte1 = Math.min(rentaImponible, tramo1);
        impuestoAnual += parte1 * 0.08;

        if (rentaImponible > tramo1) {
          const parte2 = Math.min(rentaImponible - tramo1, tramo2 - tramo1);
          impuestoAnual += parte2 * 0.14;

          if (rentaImponible > tramo2) {
            const parte3 = Math.min(rentaImponible - tramo2, tramo3 - tramo2);
            impuestoAnual += parte3 * 0.17;

            if (rentaImponible > tramo3) {
              const parte4 = Math.min(rentaImponible - tramo3, tramo4 - tramo3);
              impuestoAnual += parte4 * 0.20;

              if (rentaImponible > tramo4) {
                const parte5 = rentaImponible - tramo4;
                impuestoAnual += parte5 * 0.30;
              }
            }
          }
        }
      }

      // Retención mensual aproximada (/ 12)
      const retencionMensual = impuestoAnual / 12;
      const totalDescuentos = montoPension + retencionMensual;
      const sueldoNeto = Math.max(0, computable - totalDescuentos);
      const essaludEmpresa = computable * 0.09;

      document.getElementById('res-sueldo-neto')!.textContent = formatCurrency(sueldoNeto, 'S/');
      document.getElementById('res-total-descuentos')!.textContent = `- ${formatCurrency(totalDescuentos, 'S/')}`;
      document.getElementById('res-bruto-total')!.textContent = formatCurrency(computable, 'S/');
      document.getElementById('res-monto-pension')!.textContent = `- ${formatCurrency(montoPension, 'S/')}`;
      document.getElementById('res-monto-renta')!.textContent = `- ${formatCurrency(retencionMensual, 'S/')}`;
      document.getElementById('res-monto-essalud')!.textContent = formatCurrency(essaludEmpresa, 'S/');
      document.getElementById('res-anual-bruto')!.textContent = formatCurrency(ingresoAnual, 'S/');
      document.getElementById('res-anual-renta')!.textContent = formatCurrency(impuestoAnual, 'S/');
    } else if (activeCountry === 'co') {
      // Colombia: Salud 4% + Pensión 4% (+ retención en la fuente si aplica)
      const salud = sueldoBruto * 0.04;
      const pension = sueldoBruto * 0.04;
      const retencion = sueldoBruto > 6000000 ? (sueldoBruto - 6000000) * 0.19 : 0;
      const descuentos = salud + pension + retencion;
      const neto = sueldoBruto - descuentos;

      document.getElementById('res-sueldo-neto')!.textContent = formatCurrency(neto, '$');
      document.getElementById('res-total-descuentos')!.textContent = `- ${formatCurrency(descuentos, '$')}`;
      document.getElementById('res-bruto-total')!.textContent = formatCurrency(sueldoBruto, '$');
      document.getElementById('res-monto-pension')!.textContent = `- ${formatCurrency(salud + pension, '$')}`;
      document.getElementById('res-monto-renta')!.textContent = `- ${formatCurrency(retencion, '$')}`;
      document.getElementById('res-anual-bruto')!.textContent = formatCurrency(sueldoBruto * 12, '$');
      document.getElementById('res-anual-renta')!.textContent = formatCurrency(retencion * 12, '$');
    } else if (activeCountry === 'mx') {
      // México: IMSS trabajador ~2.5% + ISR promedio 10-25%
      const imss = sueldoBruto * 0.0275;
      const isr = sueldoBruto > 15000 ? sueldoBruto * 0.15 : sueldoBruto * 0.08;
      const desc = imss + isr;
      const neto = sueldoBruto - desc;

      document.getElementById('res-sueldo-neto')!.textContent = formatCurrency(neto, '$');
      document.getElementById('res-total-descuentos')!.textContent = `- ${formatCurrency(desc, '$')}`;
      document.getElementById('res-bruto-total')!.textContent = formatCurrency(sueldoBruto, '$');
      document.getElementById('res-monto-pension')!.textContent = `- ${formatCurrency(imss, '$')}`;
      document.getElementById('res-monto-renta')!.textContent = `- ${formatCurrency(isr, '$')}`;
      document.getElementById('res-anual-bruto')!.textContent = formatCurrency(sueldoBruto * 12, '$');
      document.getElementById('res-anual-renta')!.textContent = formatCurrency(isr * 12, '$');
    } else if (activeCountry === 'cl') {
      // Chile: AFP ~11.5% + Salud Fonasa/Isapre 7% + Seguro cesantía 0.6%
      const afp = sueldoBruto * 0.115;
      const salud = sueldoBruto * 0.07;
      const cesantia = sueldoBruto * 0.006;
      const desc = afp + salud + cesantia;
      const neto = sueldoBruto - desc;

      document.getElementById('res-sueldo-neto')!.textContent = formatCurrency(neto, '$');
      document.getElementById('res-total-descuentos')!.textContent = `- ${formatCurrency(desc, '$')}`;
      document.getElementById('res-bruto-total')!.textContent = formatCurrency(sueldoBruto, '$');
      document.getElementById('res-monto-pension')!.textContent = `- ${formatCurrency(afp + cesantia, '$')}`;
      document.getElementById('res-monto-renta')!.textContent = `- ${formatCurrency(salud, '$')}`;
      document.getElementById('res-anual-bruto')!.textContent = formatCurrency(sueldoBruto * 12, '$');
      document.getElementById('res-anual-renta')!.textContent = formatCurrency(0, '$');
    } else {
      // España: Seguridad Social ~6.35% + IRPF según tramos (12% a 25%)
      const segSocial = sueldoBruto * 0.0635;
      const irpf = sueldoBruto > 2000 ? sueldoBruto * 0.16 : sueldoBruto * 0.11;
      const desc = segSocial + irpf;
      const neto = sueldoBruto - desc;

      document.getElementById('res-sueldo-neto')!.textContent = formatCurrency(neto, '€');
      document.getElementById('res-total-descuentos')!.textContent = `- ${formatCurrency(desc, '€')}`;
      document.getElementById('res-bruto-total')!.textContent = formatCurrency(sueldoBruto, '€');
      document.getElementById('res-monto-pension')!.textContent = `- ${formatCurrency(segSocial, '€')}`;
      document.getElementById('res-monto-renta')!.textContent = `- ${formatCurrency(irpf, '€')}`;
      document.getElementById('res-anual-bruto')!.textContent = formatCurrency(sueldoBruto * 12, '€');
      document.getElementById('res-anual-renta')!.textContent = formatCurrency(irpf * 12, '€');
    }
  };

  // Country buttons
  const countryBtns = document.querySelectorAll('.country-btn');
  countryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      countryBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCountry = (btn as HTMLElement).dataset.country || 'pe';

      const secPe = document.getElementById('section-pe-inputs');
      const rowEssalud = document.getElementById('row-essalud-empleador');
      const curPrefix = document.getElementById('currency-prefix');

      if (curPrefix) {
        if (activeCountry === 'pe') curPrefix.textContent = 'S/';
        else if (activeCountry === 'es') curPrefix.textContent = '€';
        else curPrefix.textContent = '$';
      }

      if (activeCountry === 'pe') {
        if (secPe) secPe.style.display = 'block';
        if (rowEssalud) rowEssalud.style.display = 'flex';
      } else {
        if (secPe) secPe.style.display = 'none';
        if (rowEssalud) rowEssalud.style.display = 'none';
      }
      calculateSueldo();
    });
  });

  const inputs = document.querySelectorAll('#sueldo-form input, #sueldo-form select');
  inputs.forEach((inp) => {
    inp.addEventListener('input', calculateSueldo);
    inp.addEventListener('change', calculateSueldo);
  });

  const copyBtn = document.getElementById('btn-copy-sueldo');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const neto = document.getElementById('res-sueldo-neto')?.textContent || '';
      const bruto = document.getElementById('res-bruto-total')?.textContent || '';
      const text = `Sueldo Neto (UtiliaOnline):\n- Bruto: ${bruto}\n- Neto en Mano: ${neto}\nCalculado en: ${window.location.href}`;
      navigator.clipboard.writeText(text).then(() => {
        copyBtn.innerHTML = '<span>¡Copiado!</span>';
        setTimeout(() => {
          copyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copiar Boleta</span>';
        }, 2000);
      });
    });
  }

  calculateSueldo();
</script>
