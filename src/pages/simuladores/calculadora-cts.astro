  .legal-notice {
    font-size: 0.75rem;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed var(--line);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    line-height: 1.45;
  }
</style>

<script>
  let activeCountry = 'pe';

  const formatCurrency = (val: number, currency: string = 'S/') => {
    return `${currency} ${val.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  };

  const calculateCTS = () => {
    if (activeCountry === 'pe') {
      const regimen = (document.getElementById('regimen-pe') as HTMLSelectElement).value;
      const sueldo = parseFloat((document.getElementById('sueldo-pe') as HTMLInputElement).value) || 0;
      const tieneAsig = (document.getElementById('asig-fam-pe') as HTMLInputElement).checked;
      const gratif = parseFloat((document.getElementById('gratif-pe') as HTMLInputElement).value) || 0;
      const variables = parseFloat((document.getElementById('prom-variables-pe') as HTMLInputElement).value) || 0;
      const meses = parseInt((document.getElementById('meses-pe') as HTMLInputElement).value) || 0;
      const dias = parseInt((document.getElementById('dias-pe') as HTMLInputElement).value) || 0;
      const faltas = parseInt((document.getElementById('faltas-pe') as HTMLInputElement).value) || 0;
      const periodo = (document.getElementById('periodo-pe') as HTMLSelectElement).value;

      if (regimen === 'micro') {
        document.getElementById('res-total')!.textContent = 'S/ 0.00';
        document.getElementById('res-computable')!.textContent = 'S/ 0.00';
        document.getElementById('res-fecha-limite')!.textContent = 'Microempresa: no corresponde CTS por ley';
        return;
      }

      const asigMonto = tieneAsig ? 102.50 : 0;
      const sextoGratif = gratif / 6;
      let computable = sueldo + asigMonto + sextoGratif + variables;

      let factorRegimen = regimen === 'pequena' ? 0.5 : 1.0;

      // CTS por meses = (computable / 12) * meses * factor
      const montoMeses = (computable / 12) * meses * factorRegimen;
      // CTS por dias = (computable / 360) * dias * factor
      const montoDias = (computable / 360) * dias * factorRegimen;
      // Faltas se descuentan = (computable / 360) * faltas * factor
      const montoFaltas = (computable / 360) * faltas * factorRegimen;

      const total = Math.max(0, montoMeses + montoDias - montoFaltas);

      document.getElementById('res-total')!.textContent = formatCurrency(total, 'S/');
      document.getElementById('res-computable')!.textContent = formatCurrency(computable, 'S/');
      document.getElementById('res-sueldo')!.textContent = formatCurrency(sueldo, 'S/');
      document.getElementById('res-asig')!.textContent = formatCurrency(asigMonto, 'S/');
      document.getElementById('res-sexto')!.textContent = formatCurrency(sextoGratif, 'S/');
      document.getElementById('res-variables')!.textContent = formatCurrency(variables, 'S/');
      document.getElementById('res-meses')!.textContent = formatCurrency(montoMeses, 'S/');
      document.getElementById('res-dias')!.textContent = formatCurrency(montoDias, 'S/');
      document.getElementById('res-faltas')!.textContent = `- ${formatCurrency(montoFaltas, 'S/')}`;

      const fechaEl = document.getElementById('res-fecha-limite');
      if (fechaEl) {
        if (periodo === 'mayo') fechaEl.textContent = 'Fecha límite legal: 15 de Mayo';
        else if (periodo === 'noviembre') fechaEl.textContent = 'Fecha límite legal: 15 de Noviembre';
        else fechaEl.textContent = 'Abono dentro de las 48h de cese';
      }
    } else {
      // Colombia: Cesantías = (Salario + Aux) * Días / 360
      const salario = parseFloat((document.getElementById('salario-co') as HTMLInputElement).value) || 0;
      const tieneAux = (document.getElementById('aux-transporte-co') as HTMLInputElement).checked;
      const auxTransporte = tieneAux ? 162000 : 0;
      const dias = parseInt((document.getElementById('dias-co') as HTMLInputElement).value) || 0;

      const base = salario + auxTransporte;
      const cesantias = (base * dias) / 360;
      const intereses = (cesantias * dias * 0.12) / 360;

      document.getElementById('res-total')!.textContent = formatCurrency(cesantias, '$');
      document.getElementById('res-computable')!.textContent = formatCurrency(base, '$');
      document.getElementById('res-intereses-co')!.textContent = formatCurrency(intereses, '$');
      document.getElementById('res-fecha-limite')!.textContent = 'Consignación al fondo: máx. 14 de febrero';
    }
  };

  // Switch tabs
  const tabButtons = document.querySelectorAll('.country-btn');
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCountry = (btn as HTMLElement).dataset.country || 'pe';

      const secPe = document.getElementById('section-pe');
      const secCo = document.getElementById('section-co');
      const rowCo = document.getElementById('co-intereses-row');
      const peBreakdown = document.getElementById('pe-breakdown-details');
      const label = document.getElementById('result-badge-label');

      if (activeCountry === 'pe') {
        if (secPe) secPe.style.display = 'block';
        if (secCo) secCo.style.display = 'none';
        if (rowCo) rowCo.style.display = 'none';
        if (peBreakdown) peBreakdown.style.display = 'flex';
        if (label) label.textContent = 'CTS Semestral a Depositar';
      } else {
        if (secPe) secPe.style.display = 'none';
        if (secCo) secCo.style.display = 'block';
        if (rowCo) rowCo.style.display = 'flex';
        if (peBreakdown) peBreakdown.style.display = 'none';
        if (label) label.textContent = 'Cesantías Anuales a Consignar';
      }
      calculateCTS();
    });
  });

  // Listen to inputs
  const inputs = document.querySelectorAll('#cts-form input, #cts-form select');
  inputs.forEach((inp) => {
    inp.addEventListener('input', calculateCTS);
    inp.addEventListener('change', calculateCTS);
  });

  // Copy button
  const copyBtn = document.getElementById('btn-copy-cts');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const total = document.getElementById('res-total')?.textContent || '';
      const comp = document.getElementById('res-computable')?.textContent || '';
      const text = `Cálculo de CTS (UtiliaOnline):\n- Remuneración Computable: ${comp}\n- Total a Depositar: ${total}\nCalculado en: ${window.location.href}`;
      navigator.clipboard.writeText(text).then(() => {
        copyBtn.innerHTML = '<span>¡Copiado!</span>';
        setTimeout(() => {
          copyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copiar desglose</span>';
        }, 2000);
      });
    });
  }

  // Initial calculation
  calculateCTS();
</script>
