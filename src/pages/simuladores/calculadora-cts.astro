  }

  .action-buttons-row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .btn-action {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
