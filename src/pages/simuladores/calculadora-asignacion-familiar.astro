---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---

<Base
  title="Calculadora de Asignación Familiar Perú (Ley 25129) · UtiliaOnline"
  description="Calcula la asignación familiar en Perú (10% de la RMV), requisitos legales, documentos probatorios e impacto en tu CTS, gratificaciones y liquidación."
  keywords="asignacion familiar peru, ley 25129 asignacion familiar, calcular asignacion familiar, cuanto es asignacion familiar 2025, rmv 1025"
>
  <div class="tool-container">
    <div class="tool-header">
      <div class="breadcrumb">
        <a href="/">Inicio</a> / <a href="/simuladores">Simuladores</a> / <span>Asignación Familiar</span>
      </div>
      <div class="title-row">
        <div class="tool-icon-badge">
          <Icon name="users" size={28} />
        </div>
        <div>
          <h1>Calculadora de Asignación Familiar (Ley 25129)</h1>
          <p class="tool-desc">
            Verifica si cumples los requisitos de ley para percibir el 10% de la RMV y calcula cómo incrementa tus gratificaciones, depósitos de CTS, vacaciones y liquidación.
          </p>
        </div>
      </div>
    </div>

    <div class="calc-grid">
      <!-- Input Panel -->
      <div class="panel-card input-panel">
        <div class="panel-head">
          <Icon name="file-text" size={18} />
          <h2>Parámetros del Beneficio</h2>
        </div>

        <form id="asig-form" class="calc-form" onsubmit="event.preventDefault()">
          <div class="form-group">
            <label for="rmv-val">Remuneración Mínima Vital (RMV) Vigente (S/)</label>
            <div class="input-prefix-wrap">
              <span class="prefix">S/</span>
              <input type="number" id="rmv-val" class="form-input" value="1025" min="500" step="1" required />
            </div>
            <small class="hint-text">Monto oficial en Perú: S/ 1,025 (10% = S/ 102.50).</small>
          </div>

          <div class="form-group">
            <label for="sueldo-base-asig">Tu Sueldo Básico Mensual (S/)</label>
            <div class="input-prefix-wrap">
              <span class="prefix">S/</span>
              <input type="number" id="sueldo-base-asig" class="form-input" value="2500" min="0" step="0.01" />
            </div>
          </div>

          <div class="form-group">
            <label for="regimen-asig">Régimen Laboral de tu Empleador</label>
            <select id="regimen-asig" class="form-select">
              <option value="general" selected>Régimen General de la Actividad Privada (Obligatorio)</option>
              <option value="mype">Micro / Pequeña Empresa REMYPE (No obligatorio por Ley MYPE)</option>
              <option value="construccion">Construcción Civil (Régimen especial con porcentaje propio)</option>
            </select>
          </div>

          <div class="form-section-title">Hijos a Cargo</div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="hijos-menores">Hijos menores de 18 años</label>
              <input type="number" id="hijos-menores" class="form-input" value="1" min="0" max="15" />
            </div>
            <div class="form-group">
              <label for="hijos-mayores">Hijos 18-24 con estudios sup.</label>
              <input type="number" id="hijos-mayores" class="form-input" value="0" min="0" max="15" />
            </div>
          </div>
          <small class="hint-text">Tener 1 hijo o varios da derecho al mismo monto único legal (no es acumulativo por hijo).</small>
        </form>
      </div>

      <!-- Result Panel -->
      <div class="panel-card result-panel">
        <div class="panel-head">
          <Icon name="dollar-sign" size={18} />
          <h2>Monto y Beneficios Computables</h2>
        </div>

        <div class="result-highlight-card">
          <span class="result-sub-label">Asignación Familiar Mensual</span>
          <div class="result-main-value" id="res-asig-mensual">S/ 102.50</div>
          <div class="result-date-info" id="res-asig-estado">Estado: Cumple con los requisitos legales</div>
        </div>

        <div class="breakdown-list">
          <div class="breakdown-item">
            <span>Suma a tu sueldo mensual básico:</span>
            <strong id="res-asig-nuevo-sueldo">S/ 2,602.50</strong>
          </div>
          <div class="breakdown-item">
            <span>Impacto anual directo en tu sueldo (12 meses):</span>
            <strong id="res-asig-anual">S/ 1,230.00</strong>
          </div>
          <div class="breakdown-item text-success">
            <span>Aumento en cada Gratificación (+9% salud):</span>
            <strong id="res-asig-gratif">+ S/ 111.73 por semestre</strong>
          </div>
          <div class="breakdown-item text-success">
            <span>Aumento en cada depósito de CTS:</span>
            <strong id="res-asig-cts">+ S/ 60.50 por semestre</strong>
          </div>
          <div class="breakdown-item text-success">
            <span>Aumento en tus vacaciones anuales:</span>
            <strong id="res-asig-vac">+ S/ 102.50 por año</strong>
          </div>
        </div>

        <div class="action-buttons-row">
          <button type="button" class="btn-action" id="btn-copy-asig">
            <Icon name="copy" size={16} />
            <span>Copiar informe</span>
          </button>
          <button type="button" class="btn-action" onclick="window.print()">
            <Icon name="download" size={16} />
            <span>Imprimir</span>
          </button>
        </div>

        <div class="legal-notice">
          <strong>Documentos a Presentar:</strong> Para gozar de este derecho debes acreditar ante el área de Recursos Humanos la partida/acta de nacimiento del hijo menor de edad. Si tiene entre 18 y 24 años, debes presentar la constancia de matrícula o estudios superiores vigente (máximo hasta los 24 años cumplidos).
        </div>
      </div>
    </div>

    <!-- Guía y Cómo Usar (Estándar UtiliaOnline) -->
    <section class="seo-section">
      <h2>Guía completa: ¿Qué es la Asignación Familiar y cómo se calcula en el Perú?</h2>
      <p>
        La <strong>Asignación Familiar</strong> es un beneficio social de naturaleza remunerativa otorgado por ley a los trabajadores sujetos al régimen laboral de la actividad privada (D.Leg. 728) que tengan a su cargo uno o más hijos menores de edad o mayores cursando estudios superiores. Está regulada por la <strong>Ley N° 25129</strong> y su reglamento aprobado mediante el <strong>Decreto Supremo N° 035-90-TR</strong>.
      </p>
      <p>
        A diferencia de otros conceptos laborales, el monto de la asignación familiar es fijo e independiente del sueldo que perciba el trabajador: equivale exactamente al <strong>10% de la Remuneración Mínima Vital (RMV)</strong> vigente en la oportunidad de pago. Actualmente, con una RMV de S/ 1,025.00, el importe mensual asciende a <strong>S/ 102.50</strong>.
      </p>

      <h2>¿Cómo usar esta calculadora paso a paso?</h2>
      <div class="step-list">
        <div class="step-card">
          <span class="step-num">1</span>
          <div class="step-body">
            <h4>Verifica la Remuneración Mínima Vital (RMV)</h4>
            <p>El valor por defecto es la RMV oficial de S/ 1,025. Si en el futuro el gobierno actualiza el sueldo mínimo, puedes cambiar este valor para calcular el nuevo monto inmediatamente.</p>
          </div>
        </div>
        <div class="step-card">
          <span class="step-num">2</span>
          <div class="step-body">
            <h4>Indica el número de hijos que cumplen los requisitos</h4>
            <p>Ingresa la cantidad de hijos menores de 18 años o mayores de hasta 24 años con estudios superiores acreditados ante el empleador.</p>
          </div>
        </div>
        <div class="step-card">
          <span class="step-num">3</span>
          <div class="step-body">
            <h4>Ingresa tu sueldo base mensual</h4>
            <p>Escribe tu haber básico mensual para que el simulador te muestre el impacto total en tus beneficios: cuánto aumenta en Gratificaciones, CTS y Vacaciones.</p>
          </div>
        </div>
        <div class="step-card">
          <span class="step-num">4</span>
          <div class="step-body">
            <h4>Copia o imprime el informe detallado</h4>
            <p>Haz clic en "Copiar informe" o "Imprimir" para adjuntarlo a tus solicitudes de Recursos Humanos o archivo personal.</p>
          </div>
        </div>
      </div>

      <h2>Casos prácticos de aplicación</h2>
      <div class="guide-grid">
        <div class="guide-card">
          <h4>¿Se paga por cada hijo o es un pago único?</h4>
          <p>Es un monto único mensual de S/ 102.50 sin importar si tienes 1, 2, 3 o más hijos. La ley establece que se abona "al trabajador que tenga a su cargo uno o más hijos".</p>
        </div>
        <div class="guide-card">
          <h4>Ambos padres trabajan en la misma empresa</h4>
          <p>Si el padre y la madre laboran para la misma empresa o razón social, <strong>ambos tienen derecho</strong> a percibir los S/ 102.50 en sus respectivas boletas mensuales de forma independiente.</p>
        </div>
        <div class="guide-card">
          <h4>Impacto en Gratificaciones y CTS</h4>
          <p>Al tener carácter remunerativo, los S/ 102.50 se suman a la base computable: aumentan tu Gratificación de julio y diciembre en S/ 102.50 (+ bono Essalud) y tu CTS en S/ 60.50 por semestre.</p>
        </div>
        <div class="guide-card">
          <h4>Hijos mayores de 18 cursando estudios</h4>
          <p>El beneficio se extiende hasta que el hijo cumpla 24 años, siempre que acredites estudios universitarios, técnicos o superiores continuos ante el área de Recursos Humanos.</p>
        </div>
      </div>

      <h2>Preguntas frecuentes (FAQ)</h2>
      <div class="faq-wrap">
        <div class="faq-item">
          <button type="button" class="faq-question">
            <span>¿Qué documentos debo presentar a mi empleador para solicitarla?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>Debes presentar una copia simple o legalizada de la partida o acta de nacimiento del hijo menor de edad. Si tiene entre 18 y 24 años, adjunta la constancia de matrícula, carné universitario o constancia de notas vigente emitida por la universidad o instituto técnico reconocido.</p>
          </div>
        </div>
        <div class="faq-item">
          <button type="button" class="faq-question">
            <span>¿La asignación familiar está afecta a descuentos de AFP y ONP?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>Sí. Al ser un concepto remunerativo de libre disposición, la asignación familiar forma parte de la base imponible sujeta a los aportes previsionales obligatorios (AFP u ONP) y al Impuesto a la Renta de Quinta Categoría.</p>
          </div>
        </div>
        <div class="faq-item">
          <button type="button" class="faq-question">
            <span>¿Me corresponde asignación familiar si trabajo en una Microempresa REMYPE?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <p>No. En el régimen especial de la Microempresa acreditada en REMYPE la ley no contempla el pago obligatorio de asignación familiar. Sin embargo, en el régimen de Pequeña Empresa sí corresponde percibirla al 100% (S/ 102.50).</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .tool-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 1.5rem 0 3rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .breadcrumb a {
    color: var(--muted);
  }
  .breadcrumb a:hover {
    color: var(--accent);
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .tool-icon-badge {
    width: 58px;
    height: 58px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.15), rgba(16, 185, 129, 0.05));
    border: 1px solid rgba(56, 189, 248, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
  }
  .title-row h1 {
    font-size: 1.85rem;
    margin: 0 0 0.35rem 0;
    letter-spacing: -0.02em;
  }
  .tool-desc {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
    max-width: 75ch;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
  }

  .panel-card {
    background: var(--surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
  }
  .panel-head h2 {
    font-size: 1.15rem;
    color: var(--ink);
    margin: 0;
  }

  .form-group {
    margin-bottom: 1.1rem;
  }
  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    color: var(--ink);
  }
  .form-input, .form-select {
    width: 100%;
    padding: 0.6rem 0.85rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: 0.95rem;
    transition: border-color 0.15s;
  }
  .form-input:focus, .form-select:focus {
    outline: none;
    border-color: var(--accent);
  }
  .input-prefix-wrap {
    display: flex;
    align-items: center;
    position: relative;
  }
  .input-prefix-wrap .prefix {
    position: absolute;
    left: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .input-prefix-wrap .form-input {
    padding-left: 2.2rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }
  .form-section-title {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin: 1.1rem 0 0.65rem;
    padding-top: 0.45rem;
    border-top: 1px solid var(--line);
  }
  .hint-text {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  /* Result Panel */
  .result-highlight-card {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.12), rgba(16, 185, 129, 0.08));
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    text-align: center;
    margin-bottom: 1.25rem;
  }
  .result-sub-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-weight: 600;
  }
  .result-main-value {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--accent);
    margin: 0.25rem 0;
    font-family: var(--font-heading, sans-serif);
  }
  .result-date-info {
    font-size: 0.82rem;
    color: var(--ink);
    font-weight: 500;
  }

  .breakdown-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1rem;
    margin-bottom: 1.25rem;
  }
  .breakdown-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
  }
  .text-success {
    color: #10b981;
  }

  .action-buttons-row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .btn-action {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--surface-card);
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .btn-action:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .legal-notice {
    font-size: 0.75rem;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed var(--line);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    line-height: 1.45;
  }
</style>

<script>
  const formatCurrency = (val: number) => {
    return `S/ ${val.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  };

  const calculateAsig = () => {
    const rmv = parseFloat((document.getElementById('rmv-val') as HTMLInputElement).value) || 1025;
    const sueldo = parseFloat((document.getElementById('sueldo-base-asig') as HTMLInputElement).value) || 0;
    const regimen = (document.getElementById('regimen-asig') as HTMLSelectElement).value;
    const menores = parseInt((document.getElementById('hijos-menores') as HTMLInputElement).value) || 0;
    const mayores = parseInt((document.getElementById('hijos-mayores') as HTMLInputElement).value) || 0;

    const totalHijos = menores + mayores;
    const tieneDerecho = totalHijos > 0 && regimen === 'general';

    const montoMensual = tieneDerecho ? (rmv * 0.10) : 0;
    const nuevoSueldo = sueldo + montoMensual;
    const anualSueldo = montoMensual * 12;
    const aumentoGratif = montoMensual * 1.09; // gratif + 9% bono
    const aumentoCts = (montoMensual + (montoMensual / 6)) / 2; // por semestre
    const aumentoVac = montoMensual;

    document.getElementById('res-asig-mensual')!.textContent = formatCurrency(montoMensual);
    document.getElementById('res-asig-nuevo-sueldo')!.textContent = formatCurrency(nuevoSueldo);
    document.getElementById('res-asig-anual')!.textContent = formatCurrency(anualSueldo);
    document.getElementById('res-asig-gratif')!.textContent = `+ ${formatCurrency(aumentoGratif)} por semestre`;
    document.getElementById('res-asig-cts')!.textContent = `+ ${formatCurrency(aumentoCts)} por semestre`;
    document.getElementById('res-asig-vac')!.textContent = `+ ${formatCurrency(aumentoVac)} por año`;

    const estadoEl = document.getElementById('res-asig-estado');
    if (estadoEl) {
      if (regimen === 'mype') {
        estadoEl.textContent = 'En MYPE no es obligatorio otorgar asignación familiar por ley.';
      } else if (totalHijos === 0) {
        estadoEl.textContent = 'Requiere al menos 1 hijo menor de 18 o hasta 24 con estudios.';
      } else {
        estadoEl.textContent = 'Estado: Cumples con todos los requisitos de ley.';
      }
    }
  };

  const inputs = document.querySelectorAll('#asig-form input, #asig-form select');
  inputs.forEach((inp) => {
    inp.addEventListener('input', calculateAsig);
    inp.addEventListener('change', calculateAsig);
  });

  const copyBtn = document.getElementById('btn-copy-asig');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const monto = document.getElementById('res-asig-mensual')?.textContent || '';
      const text = `Asignación Familiar (UtiliaOnline):\n- Monto Mensual: ${monto}\nCalculado en: ${window.location.href}`;
      navigator.clipboard.writeText(text).then(() => {
        copyBtn.innerHTML = '<span>¡Copiado!</span>';
        setTimeout(() => {
          copyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copiar informe</span>';
        }, 2000);
      });
    });
  }

  calculateAsig();
</script>
