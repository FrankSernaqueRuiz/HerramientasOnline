    color: var(--ink);
    font-size: 0.95rem;
    transition: border-color 0.15s;
  }
  .form-input:focus, .form-select:focus {
    outline: none;
    border-color: var(--accent);
  }
  .input-prefix-wrap {
    display: flex;
    align-items: center;
    position: relative;
  }
  .input-prefix-wrap .prefix {
    position: absolute;
    left: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .input-prefix-wrap .form-input {
    padding-left: 2.2rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }
  .hint-text {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  /* Comparison Cards */
  .comparison-cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  @media (max-width: 540px) {
    .comparison-cards-grid {
      grid-template-columns: 1fr;
