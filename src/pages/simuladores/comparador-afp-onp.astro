    margin-top: 1.5rem;
  }
  .comp-matrix-wrap {
    overflow-x: auto;
  }
  .comp-matrix {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .comp-matrix th {
    background: var(--surface-card);
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-weight: 600;
    text-align: left;
  }
  .comp-matrix td {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    vertical-align: top;
    line-height: 1.4;
  }
  .comp-matrix tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }
</style>

<script>
  const formatCurrency = (val: number) => {
    return `S/ ${val.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  };

  const calculateComparativa = () => {
    const edadActual = parseInt((document.getElementById('edad-actual') as HTMLInputElement).value) || 30;
    const edadJub = 65;
    const sueldo = parseFloat((document.getElementById('sueldo-afp-onp') as HTMLInputElement).value) || 0;
    const anosPrevios = parseInt((document.getElementById('anos-aportados') as HTMLInputElement).value) || 0;
    const tasaFondo = parseFloat((document.getElementById('fondo-afp-select') as HTMLSelectElement).value) || 0.07;

    const anosFaltantes = Math.max(0, edadJub - edadActual);
    const anosTotales = anosPrevios + anosFaltantes;

    // Descuentos mensuales
    const descAFP = sueldo * 0.118; // 10% fondo + 1.4% seguro + 0.4% prom
    const descONP = sueldo * 0.13;

    // Proyeccion AFP:
    // Aporte a fondo = 10% del sueldo por 12 meses
    const aporteAnualFondo = (sueldo * 0.10) * 12;
    // Tasa mensual efectiva: (1 + tasaFondo)^(1/12) - 1
    let fondoAcumulado = 0;
    const mesesFaltantes = anosFaltantes * 12;
    const aporteMensualFondo = sueldo * 0.10;
    const tasaMensual = Math.pow(1 + tasaFondo, 1 / 12) - 1;

    for (let m = 1; m <= mesesFaltantes; m++) {
      fondoAcumulado = (fondoAcumulado + aporteMensualFondo) * (1 + tasaMensual);
    }

    // Si ya tenia anos previos, estimamos un fondo inicial
    const fondoPrevioEstimado = (anosPrevios * aporteAnualFondo) * Math.pow(1 + tasaFondo, anosFaltantes);
    const fondoTotalAFP = fondoAcumulado + fondoPrevioEstimado;

    // Pension estimada AFP (aprox factor capital pension: ~S/ 5.50 por cada S/ 1,000 acumulados)
    const pensionEstimadaAFP = (fondoTotalAFP / 1000) * 5.50;
    const retiro955 = fondoTotalAFP * 0.955;

    // Pension ONP:
    // Maximo legal: S/ 893. Minimo con 20 anos: S/ 500. Proporcional 10-14 anos: S/ 250 - 350. Menos de 10 anos: S/ 0.
    let pensionONP = 0;
    let estadoONP = '';

    if (anosTotales >= 20) {
      // 50% de remuneracion de referencia (tope S/ 893)
      pensionONP = Math.min(sueldo * 0.50, 893);
      estadoONP = pensionONP >= 893 ? 'Tope máximo legal alcanzado (S/ 893)' : 'Pensión completa según años de aporte';
    } else if (anosTotales >= 15) {
      pensionONP = 350;
      estadoONP = 'Pensión reducida proporcional (15 a 19 años)';
    } else if (anosTotales >= 10) {
      pensionONP = 250;
      estadoONP = 'Pensión reducida proporcional (10 a 14 años)';
    } else {
      pensionONP = 0;
      estadoONP = 'Menos de 10 años: No alcanza pensión en ONP';
    }

    document.getElementById('res-afp-fondo')!.textContent = formatCurrency(fondoTotalAFP);
    document.getElementById('res-afp-pension')!.textContent = formatCurrency(pensionEstimadaAFP);
    document.getElementById('res-afp-retiro')!.textContent = retiro955.toLocaleString('es-PE', { maximumFractionDigits: 0 });

    document.getElementById('res-onp-pension')!.textContent = formatCurrency(pensionONP);
    document.getElementById('res-onp-estado')!.textContent = estadoONP;

    document.getElementById('res-desc-afp')!.textContent = formatCurrency(descAFP);
    document.getElementById('res-desc-onp')!.textContent = formatCurrency(descONP);
    document.getElementById('res-anos-totales')!.textContent = `${anosTotales} años`;
  };

  const inputs = document.querySelectorAll('#afp-onp-form input, #afp-onp-form select');
  inputs.forEach((inp) => {
    inp.addEventListener('input', calculateComparativa);
    inp.addEventListener('change', calculateComparativa);
  });

  const copyBtn = document.getElementById('btn-copy-comp');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const afpFondo = document.getElementById('res-afp-fondo')?.textContent || '';
      const onpPen = document.getElementById('res-onp-pension')?.textContent || '';
      const text = `Comparativa AFP vs ONP (UtiliaOnline):\n- Fondo Proyectado AFP: ${afpFondo}\n- Pensión Proyectada ONP: ${onpPen}\nCalculado en: ${window.location.href}`;
      navigator.clipboard.writeText(text).then(() => {
        copyBtn.innerHTML = '<span>¡Copiado!</span>';
        setTimeout(() => {
          copyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copiar comparativa</span>';
        }, 2000);
      });
    });
  }

  calculateComparativa();
</script>
