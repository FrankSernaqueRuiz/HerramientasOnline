---
import Base from '../layouts/Base.astro';
---
<Base title="Calculadora del Valor Real de tu Hora de Trabajo" description="Calcula cuánto vale realmente tu hora considerando horas de traslado, comida y gastos fijos del trabajo.">
  <div class="page-header">
    <div class="breadcrumb"><a href="/">Herramientas</a> / <span>Dinero y compras</span></div>
    <h1>Valor Real de tu Hora de Trabajo</h1>
    <p class="lead">Descubre cuánto ganas realmente por hora al incluir el tiempo de traslado, gastos de transporte y otros costos laborales.</p>
  </div>
  <section class="panel">
    <div class="vh-grid">
      <div>
        <div class="field"><label>Sueldo mensual neto ($):</label><input type="number" id="vh-salary" min="0" value="1500"/></div>
        <div class="field"><label>Días laborables al mes:</label><input type="number" id="vh-days" min="1" max="31" value="22"/></div>
        <div class="field"><label>Horas de trabajo por día:</label><input type="number" id="vh-hours" min="1" max="24" step="0.5" value="8"/></div>
        <div class="field"><label>Horas de traslado por día (ida+vuelta):</label><input type="number" id="vh-commute" min="0" max="8" step="0.5" value="1.5"/></div>
        <div class="field"><label>Gastos mensuales del trabajo ($) (transporte, comida, ropa):</label><input type="number" id="vh-expenses" min="0" value="150"/></div>
      </div>
      <div class="result-panel">
        <div class="res-item big"><span class="lbl">Tu hora real vale</span><span class="val" id="r-real">$0</span></div>
        <div class="res-item"><span class="lbl">Hora nominal (sin descontar)</span><span class="val" id="r-nominal">$0</span></div>
        <div class="res-item"><span class="lbl">Horas reales al mes (con traslado)</span><span class="val" id="r-hours">0 h</span></div>
        <div class="res-item"><span class="lbl">Ingreso neto real mensual</span><span class="val" id="r-net">$0</span></div>
        <div class="res-item"><span class="lbl">Diferencia por hora</span><span class="val red" id="r-diff">-$0</span></div>
      </div>
    </div>
  </section>
</Base>
<style>
  .breadcrumb{font-size:.85rem;color:var(--muted);margin-bottom:.5rem}.breadcrumb a{color:var(--muted)}
  .vh-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}@media(max-width:768px){.vh-grid{grid-template-columns:1fr}}
  .field{margin-bottom:1rem}.field label{display:block;font-weight:600;font-size:.88rem;margin-bottom:.4rem}
  .field input{width:100%}
  .result-panel{background:var(--surface-card);border:1px solid var(--line);border-radius:var(--radius-sm);padding:1.5rem;display:flex;flex-direction:column;gap:1rem}
  .res-item{display:flex;justify-content:space-between;align-items:center;padding:.5rem 0;border-bottom:1px solid var(--line)}
  .res-item:last-child{border:none}
  .res-item.big{flex-direction:column;text-align:center;padding:1rem 0;border:none}
  .lbl{font-size:.85rem;color:var(--muted);font-weight:500}
  .res-item.big .lbl{text-transform:uppercase;font-weight:700;font-size:.78rem;margin-bottom:.25rem}
  .val{font-weight:700;font-size:1.05rem;color:var(--ink)}
  .res-item.big .val{font-size:2.5rem;color:var(--accent);font-weight:800}
  .red{color:#f85149}
</style>
<script>
  const els=['vh-salary','vh-days','vh-hours','vh-commute','vh-expenses'].map(id=>document.getElementById(id) as HTMLInputElement);
  const [salary,days,hours,commute,expenses]=els;
  const rReal=document.getElementById('r-real')!;const rNom=document.getElementById('r-nominal')!;
  const rHours=document.getElementById('r-hours')!;const rNet=document.getElementById('r-net')!;const rDiff=document.getElementById('r-diff')!;
  function calc(){
    const s=parseFloat(salary.value)||0;const d=parseFloat(days.value)||22;
    const h=parseFloat(hours.value)||8;const c=parseFloat(commute.value)||0;const e=parseFloat(expenses.value)||0;
    const totalHoursMonth=d*(h+c);const nominalHours=d*h;
    const netIncome=s-e;const realHourly=totalHoursMonth?netIncome/totalHoursMonth:0;
    const nomHourly=nominalHours?s/nominalHours:0;
    rReal.textContent=`$${realHourly.toFixed(2)}`;rNom.textContent=`$${nomHourly.toFixed(2)}`;
    rHours.textContent=`${totalHoursMonth.toFixed(0)} h`;rNet.textContent=`$${netIncome.toFixed(2)}`;
    const diff=realHourly-nomHourly;rDiff.textContent=`${diff>=0?'+':''}$${diff.toFixed(2)}/h`;
  }
  els.forEach(el=>el.addEventListener('input',calc));calc();
</script>
