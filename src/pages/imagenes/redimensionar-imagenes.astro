---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Redimensionar Imágenes Online – Cambiar Tamaño Gratis y Privado" description="Modifica el ancho, alto y peso de tus fotos en JPG, PNG o WebP directamente en tu navegador sin subir tus archivos a ningún servidor.">
  <div class="page-header">
    <div class="breadcrumb"><a href="/">Herramientas</a> / <span>Imágenes y multimedia</span></div>
    <h1>Redimensionar Imágenes en Línea</h1>
    <p class="lead">Ajusta dimensiones por píxeles o porcentaje y optimiza el peso de tus imágenes con total privacidad: todo se procesa en tu dispositivo.</p>
  </div>

  <section class="panel">
    <!-- Drop zone -->
    <div class="drop-zone" id="drop-zone">
      <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp" style="display:none;" />
      <div class="drop-content">
        <span class="drop-icon">🖼️</span>
        <p class="drop-text">Arrastra tu imagen aquí o <button type="button" class="btn btn-secondary btn-sm" id="btn-browse">Examinar archivos</button></p>
        <span class="drop-hint">Formatos compatibles: JPG, PNG, WebP (100% privado en tu navegador)</span>
      </div>
    </div>

    <!-- Resizing Controls (Hidden until image selected) -->
    <div class="resize-workspace" id="workspace" style="display:none;">
      <div class="workspace-grid">
        <!-- Controls Column -->
        <div class="controls-col">
          <h3>Opciones de redimensionado</h3>

          <div class="unit-toggle">
            <button type="button" class="toggle-btn active" id="btn-mode-px">Por Píxeles</button>
            <button type="button" class="toggle-btn" id="btn-mode-pct">Por Porcentaje (%)</button>
          </div>

          <div id="px-inputs" class="inputs-group">
            <div class="grid-2">
              <div class="field">
                <label for="width-px">Ancho (px):</label>
                <input type="number" id="width-px" min="1" class="form-input" />
              </div>
              <div class="field">
                <label for="height-px">Alto (px):</label>
                <input type="number" id="height-px" min="1" class="form-input" />
              </div>
            </div>
          </div>

          <div id="pct-inputs" class="inputs-group" style="display:none;">
            <div class="field">
              <label for="pct-range">Escala: <strong id="pct-label">75%</strong></label>
              <input type="range" id="pct-range" min="10" max="200" value="75" class="slider" />
            </div>
          </div>

          <div class="field chk-field">
            <label class="checkbox-label">
              <input type="checkbox" id="chk-aspect" checked />
              <span>Bloquear relación de aspecto (mantener proporción)</span>
            </label>
          </div>

          <div class="field">
            <label class="field-title">Formato de descarga:</label>
            <div class="format-chips" id="format-chips">
              <button type="button" class="chip-btn active" data-format="image/jpeg" data-ext="jpg">
                <div class="chip-top">
                  <span class="chip-name">JPG / JPEG</span>
                  <span class="chip-badge">Universal</span>
                </div>
                <span class="chip-desc">Ideal para fotos y redes sociales</span>
              </button>
              <button type="button" class="chip-btn" data-format="image/png" data-ext="png">
                <div class="chip-top">
                  <span class="chip-name">PNG</span>
                  <span class="chip-badge">Sin pérdida</span>
                </div>
                <span class="chip-desc">Conserva fondos transparentes</span>
              </button>
              <button type="button" class="chip-btn" data-format="image/webp" data-ext="webp">
                <div class="chip-top">
                  <span class="chip-name">WebP</span>
                  <span class="chip-badge">Ligero</span>
                </div>
                <span class="chip-desc">Máxima compresión para sitios web</span>
              </button>
              <button type="button" class="chip-btn" data-format="image/avif" data-ext="avif">
                <div class="chip-top">
                  <span class="chip-name">AVIF</span>
                  <span class="chip-badge">Última gen</span>
                </div>
                <span class="chip-desc">Ultra compresión moderna</span>
              </button>
            </div>
            <select id="format-select" class="visually-hidden" aria-hidden="true">
              <option value="image/jpeg" selected>JPG</option>
              <option value="image/png">PNG</option>
              <option value="image/webp">WebP</option>
              <option value="image/avif">AVIF</option>
            </select>
          </div>

          <div class="field" id="quality-field">
            <label for="quality-range">Calidad de compresión: <strong id="quality-label">85%</strong></label>
            <input type="range" id="quality-range" min="10" max="100" value="85" class="slider" />
          </div>

          <button type="button" class="btn btn-primary btn-block" id="btn-download">💾 Descargar imagen como .JPG</button>
        </div>

        <!-- Preview Column -->
        <div class="preview-col">
          <h3>Vista previa</h3>
          <div class="image-preview-wrapper">
            <img id="preview-img" alt="Vista previa" />
          </div>
          <div class="image-meta" id="image-meta">
            <!-- Dimensions info -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="seo-section">
    <h2>¿Cómo funciona el redimensionador y compresor de imágenes online?</h2>
    <p>Reducir las dimensiones y el peso de una fotografía es indispensable para que las páginas web carguen rápido, los correos no reboten por exceso de peso y las plataformas oficiales acepten tus documentos. Esta herramienta procesa tus imágenes mediante el elemento HTML5 Canvas y el motor gráfico de tu propio navegador, garantizando un reescalado nítido con interpolación bicúbica sin enviar tus fotos a servidores externos.</p>

    <div class="step-list">
      <div class="step-card">
        <span class="step-num">1</span>
        <div class="step-body">
          <h4>Arrastra o selecciona tu imagen</h4>
          <p>Sube cualquier archivo en formato JPG, PNG o WebP desde tu ordenador o teléfono móvil.</p>
        </div>
      </div>
      <div class="step-card">
        <span class="step-num">2</span>
        <div class="step-body">
          <h4>Ajusta el tamaño en píxeles, porcentaje o milímetros</h4>
          <p>Indica el ancho o alto deseado. Si mantienes activo el candado de relación de aspecto, la otra dimensión se adaptará automáticamente sin deformar la foto.</p>
        </div>
      </div>
      <div class="step-card">
        <span class="step-num">3</span>
        <div class="step-body">
          <h4>Selecciona el formato y descarga la imagen optimizada</h4>
          <p>Elige entre JPG (ideal para fotografías), PNG (con transparencia) o WebP moderno y pulsa "Descargar imagen redimensionada".</p>
        </div>
      </div>
    </div>

    <h3>Casos de uso para optimización visual</h3>
    <div class="guide-grid">
      <div class="guide-card">
        <h4>Trámites gubernamentales y visas</h4>
        <p>Ajusta tu foto a los requisitos estrictos de tamaño máximo (ej: "menos de 200 KB y exactamente 600x600 px") de embajadas y portales de empleo.</p>
      </div>
      <div class="guide-card">
        <h4>Tiendas online y páginas web (SEO)</h4>
        <p>Reduce fotos de cámara de 8 MB a versiones ligeras de 80 KB para mejorar la velocidad de carga (Core Web Vitals) en Google.</p>
      </div>
      <div class="guide-card">
        <h4>Redes sociales y banners publicitarios</h4>
        <p>Adapta imágenes a las medidas exactas de cabeceras de LinkedIn, posts de Instagram o miniaturas de YouTube.</p>
      </div>
    </div>

    <h2>Preguntas frecuentes sobre redimensión de fotos</h2>
    <div class="faq-wrap">
      <div class="faq-item">
        <div class="faq-question">¿Mis fotos se suben a algún servidor en internet?</div>
        <div class="faq-answer">
          <p>No. En UtiliaOnline todo el reescalado, compresión y cambio de formato se realiza en la memoria RAM de tu navegador. Tus fotografías privadas nunca salen de tu ordenador o teléfono.</p>
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-question">¿Qué significa bloquear la relación de aspecto?</div>
        <div class="faq-answer">
          <p>Significa que la imagen conserva sus proporciones originales de ancho y alto, evitando que las personas u objetos se vean estirados, achatados o deformados al cambiar el tamaño.</p>
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-question">¿Cuál es el mejor formato de descarga: JPG, PNG o WebP?</div>
        <div class="faq-answer">
          <p>Para fotografías complejas el formato <strong>JPG</strong> ofrece el mejor balance entre peso y calidad. Para logotipos o imágenes con fondo transparente usa <strong>PNG</strong>. Para páginas web modernas, <strong>WebP</strong> ofrece hasta un 30% más de compresión con la misma calidad.</p>
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-question">¿Hay algún límite en la cantidad de fotos o tamaño de archivo?</div>
        <div class="faq-answer">
          <p>Al procesarse en tu propio dispositivo, puedes redimensionar tantas imágenes como desees de forma completamente gratuita y sin marcas de agua.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .breadcrumb{font-size:.85rem;color:var(--muted);margin-bottom:.5rem}.breadcrumb a{color:var(--muted)}
  .drop-zone{border:2px dashed var(--line);border-radius:var(--radius);padding:3rem 1.5rem;text-align:center;background:var(--surface-card);transition:all .2s;cursor:pointer}
  .drop-zone.dragover{border-color:var(--accent);background:rgba(37,99,235,.05)}
  .drop-icon{font-size:2.8rem;display:block;margin-bottom:.75rem}
  .drop-text{font-size:1.05rem;color:var(--ink);margin-bottom:.5rem}
  .drop-hint{font-size:.82rem;color:var(--muted)}

  .resize-workspace{margin-top:2rem}
  .workspace-grid{display:grid;grid-template-columns:360px 1fr;gap:2rem;align-items:start}
  @media(max-width:850px){.workspace-grid{grid-template-columns:1fr}}

  .controls-col h3, .preview-col h3{font-size:1rem;margin-bottom:1rem}
  .unit-toggle{display:flex;gap:.4rem;margin-bottom:1.2rem;background:var(--bg);padding:4px;border-radius:var(--radius-sm);border:1px solid var(--line)}
  .toggle-btn{flex:1;background:transparent;border:none;padding:.45rem;font-size:.85rem;font-weight:600;color:var(--muted);border-radius:var(--radius-sm);cursor:pointer}
  .toggle-btn.active{background:var(--surface-card);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.1)}

  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
  .field{margin-bottom:1.2rem}
  .field label, .field-title{display:block;font-weight:600;font-size:.84rem;margin-bottom:.35rem}
  .form-input{width:100%;padding:.55rem .75rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font:inherit}
  .slider{width:100%;accent-color:var(--accent)}
  .chk-field{margin-bottom:1.2rem}
  .checkbox-label{display:flex;align-items:center;gap:.5rem;font-size:.85rem;cursor:pointer}
  .btn-block{width:100%;padding:.75rem;font-size:1rem;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;cursor:pointer;border-radius:var(--radius-sm);border:none;background:var(--accent);color:var(--accent-ink);transition:all .18s ease}
  .btn-block:hover{filter:brightness(1.08);transform:translateY(-1px)}

  /* Selector visual de formatos */
  .format-chips{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;margin-top:.4rem}
  .chip-btn{
    background:var(--bg);
    border:1px solid var(--line);
    border-radius:var(--radius-sm);
    padding:.65rem .75rem;
    cursor:pointer;
    text-align:left;
    display:flex;
    flex-direction:column;
    gap:.2rem;
    transition:all .15s ease;
  }
  .chip-btn:hover{border-color:var(--accent);background:var(--surface-hover)}
  .chip-btn.active{
    border-color:var(--accent);
    background:rgba(37,99,235,.08);
    box-shadow:0 0 0 1px var(--accent);
  }
  .chip-top{display:flex;justify-content:space-between;align-items:center}
  .chip-name{font-size:.9rem;font-weight:700;color:var(--ink)}
  .chip-btn.active .chip-name{color:var(--accent)}
  .chip-badge{font-size:.68rem;padding:1px 5px;border-radius:4px;background:var(--surface-card);border:1px solid var(--line);color:var(--muted);font-weight:600}
  .chip-btn.active .chip-badge{background:var(--accent);color:#fff;border-color:var(--accent)}
  .chip-desc{font-size:.72rem;color:var(--muted);line-height:1.2}
  .visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

  .image-preview-wrapper{background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);padding:1rem;display:flex;align-items:center;justify-content:center;min-height:260px;max-height:420px;overflow:hidden}
  .image-preview-wrapper img{max-width:100%;max-height:400px;object-fit:contain;border-radius:4px}
  .image-meta{display:flex;justify-content:space-around;background:var(--surface-card);border:1px solid var(--line);border-radius:var(--radius-sm);padding:.8rem;margin-top:.8rem;font-size:.85rem;flex-wrap:wrap;gap:.5rem}
</style>

<script>
  let originalImage: HTMLImageElement | null = null;
  let originalFile: File | null = null;
  let originalRatio = 1;
  let currentFormat = 'image/jpeg';
  let currentExt = 'jpg';

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const btnBrowse = document.getElementById('btn-browse')!;
  const workspace = document.getElementById('workspace')!;
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const imageMeta = document.getElementById('image-meta')!;

  const btnModePx = document.getElementById('btn-mode-px')!;
  const btnModePct = document.getElementById('btn-mode-pct')!;
  const pxInputs = document.getElementById('px-inputs')!;
  const pctInputs = document.getElementById('pct-inputs')!;

  const widthInp = document.getElementById('width-px') as HTMLInputElement;
  const heightInp = document.getElementById('height-px') as HTMLInputElement;
  const pctRange = document.getElementById('pct-range') as HTMLInputElement;
  const pctLabel = document.getElementById('pct-label')!;
  const chkAspect = document.getElementById('chk-aspect') as HTMLInputElement;

  const formatChips = document.getElementById('format-chips')!;
  const formatSelect = document.getElementById('format-select') as HTMLSelectElement;
  const qualityRange = document.getElementById('quality-range') as HTMLInputElement;
  const qualityLabel = document.getElementById('quality-label')!;
  const qualityField = document.getElementById('quality-field')!;
  const btnDownload = document.getElementById('btn-download') as HTMLButtonElement;

  btnBrowse.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput.click();
  });

  dropZone.addEventListener('click', () => fileInput.click());

  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('dragover');
  });

  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    if (e.dataTransfer?.files.length) {
      loadFile(e.dataTransfer.files[0]);
    }
  });

  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) {
      loadFile(fileInput.files[0]);
    }
  });

  function setFormat(mime: string, ext: string) {
    currentFormat = mime;
    currentExt = ext;
    formatSelect.value = mime;

    // Actualizar botones de formato
    const chips = formatChips.querySelectorAll('.chip-btn');
    chips.forEach((btn) => {
      const el = btn as HTMLButtonElement;
      if (el.dataset.format === mime) {
        el.classList.add('active');
      } else {
        el.classList.remove('active');
      }
    });

    // Control de calidad (PNG es sin pérdida)
    if (mime === 'image/png') {
      qualityField.style.display = 'none';
    } else {
      qualityField.style.display = 'block';
    }

    // Actualizar texto del botón de descarga
    btnDownload.textContent = `💾 Descargar imagen como .${ext.toUpperCase()}`;
    updateMeta();
  }

  // Click en chips de formato
  formatChips.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.chip-btn') as HTMLButtonElement;
    if (target && target.dataset.format && target.dataset.ext) {
      setFormat(target.dataset.format, target.dataset.ext);
    }
  });

  function loadFile(file: File) {
    if (!file.type.startsWith('image/')) {
      alert('Por favor selecciona una imagen válida (JPG, PNG, WebP o AVIF)');
      return;
    }
    originalFile = file;

    // Auto-detectar formato original del archivo subido
    if (file.type === 'image/png') {
      setFormat('image/png', 'png');
    } else if (file.type === 'image/webp') {
      setFormat('image/webp', 'webp');
    } else if (file.type === 'image/avif') {
      setFormat('image/avif', 'avif');
    } else {
      setFormat('image/jpeg', 'jpg');
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        originalImage = img;
        originalRatio = img.width / img.height;
        widthInp.value = String(img.width);
        heightInp.value = String(img.height);
        previewImg.src = img.src;
        workspace.style.display = 'block';
        updateMeta();
      };
      img.src = e.target?.result as string;
    };
    reader.readAsDataURL(file);
  }

  function updateMeta() {
    if (!originalImage || !originalFile) return;
    const currentW = parseInt(widthInp.value, 10) || 0;
    const currentH = parseInt(heightInp.value, 10) || 0;
    const origSizeKb = (originalFile.size / 1024).toFixed(1);
    const origExt = originalFile.name.split('.').pop()?.toUpperCase() || 'IMG';

    imageMeta.innerHTML = `
      <div>Original: <strong>${originalImage.width} × ${originalImage.height} px</strong> (${origExt}, ${origSizeKb} KB)</div>
      <div>Salida: <strong>${currentW} × ${currentH} px</strong> (.${currentExt.toUpperCase()})</div>
    `;
  }

  widthInp.addEventListener('input', () => {
    if (chkAspect.checked && originalRatio) {
      const w = parseInt(widthInp.value, 10) || 0;
      heightInp.value = String(Math.round(w / originalRatio));
    }
    updateMeta();
  });

  heightInp.addEventListener('input', () => {
    if (chkAspect.checked && originalRatio) {
      const h = parseInt(heightInp.value, 10) || 0;
      widthInp.value = String(Math.round(h * originalRatio));
    }
    updateMeta();
  });

  btnModePx.addEventListener('click', () => {
    btnModePx.classList.add('active');
    btnModePct.classList.remove('active');
    pxInputs.style.display = 'block';
    pctInputs.style.display = 'none';
  });

  btnModePct.addEventListener('click', () => {
    btnModePct.classList.add('active');
    btnModePx.classList.remove('active');
    pxInputs.style.display = 'none';
    pctInputs.style.display = 'block';
    applyPct();
  });

  pctRange.addEventListener('input', () => {
    pctLabel.textContent = `${pctRange.value}%`;
    applyPct();
  });

  function applyPct() {
    if (!originalImage) return;
    const scale = parseInt(pctRange.value, 10) / 100;
    widthInp.value = String(Math.round(originalImage.width * scale));
    heightInp.value = String(Math.round(originalImage.height * scale));
    updateMeta();
  }

  qualityRange.addEventListener('input', () => {
    qualityLabel.textContent = `${qualityRange.value}%`;
  });

  btnDownload.addEventListener('click', () => {
    if (!originalImage || !originalFile) return;
    const targetW = parseInt(widthInp.value, 10);
    const targetH = parseInt(heightInp.value, 10);
    if (!targetW || !targetH) return;

    const canvas = document.createElement('canvas');
    canvas.width = targetW;
    canvas.height = targetH;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Si se exporta a JPEG y la imagen original puede tener transparencia, pintar fondo blanco
    if (currentFormat === 'image/jpeg') {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, targetW, targetH);
    }

    // Escalado de alta calidad
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(originalImage, 0, 0, targetW, targetH);

    const quality = parseInt(qualityRange.value, 10) / 100;
    let dataUrl = canvas.toDataURL(currentFormat, quality);
    let finalExt = currentExt;

    // Si el navegador no soporta el formato pedido (ej. AVIF en navegadores antiguos), fallback a WebP o PNG
    if (!dataUrl.startsWith(`data:${currentFormat}`)) {
      finalExt = 'webp';
      dataUrl = canvas.toDataURL('image/webp', quality);
      if (!dataUrl.startsWith('data:image/webp')) {
        finalExt = 'png';
        dataUrl = canvas.toDataURL('image/png');
      }
    }

    // Mantener el nombre base del archivo original
    const baseName = originalFile.name.replace(/\.[^/.]+$/, '');
    const link = document.createElement('a');
    link.download = `${baseName}_${targetW}x${targetH}.${finalExt}`;
    link.href = dataUrl;
    link.click();
  });
</script>
