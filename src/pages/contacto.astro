---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base 
  title="Contacto y Soporte · UtiliaOnline" 
  description="Ponte en contacto con el equipo de UtiliaOnline para sugerencias, reportar fallos o proponer nuevas herramientas."
>
  <div class="page-header">
    <div class="breadcrumb"><a href="/">Inicio</a> / <span>Contacto</span></div>
    <h1>Contacto y Soporte</h1>
    <p class="lead">¿Tienes alguna duda, encontraste un fallo o quieres sugerir una nueva herramienta? Escríbenos directamente.</p>
  </div>

  <div class="contact-layout">
    <!-- Formulario de contacto -->
    <section class="panel contact-form-card">
      <h2>Envíanos un mensaje</h2>
      <p class="section-desc">Completa el formulario y te responderemos a la brevedad a tu correo.</p>

      <form id="contact-form" class="contact-form">
        <!-- Campos ocultos de configuración para FormSubmit -->
        <input type="hidden" name="_subject" value="Nuevo mensaje desde UtiliaOnline" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <!-- Campo honeypot anti-spam -->
        <input type="text" name="_honey" style="display:none" />

        <div class="form-group">
          <label for="contact-name">Tu nombre:</label>
          <input type="text" id="contact-name" name="name" required placeholder="Ej: Carlos Mendoza" class="form-input" />
        </div>

        <div class="form-group">
          <label for="contact-email">Tu correo electrónico:</label>
          <input type="email" id="contact-email" name="email" required placeholder="tu-correo@ejemplo.com" class="form-input" />
          <span class="field-hint">Usaremos este correo para responderte.</span>
        </div>

        <div class="form-group">
          <label for="contact-subject">Motivo del mensaje:</label>
          <select id="contact-subject" name="subject" class="form-input">
            <option value="Sugerir nueva herramienta">💡 Sugerir una nueva herramienta</option>
            <option value="Reportar un fallo o bug">🐛 Reportar un error o fallo</option>
            <option value="Consulta general o duda">❓ Consulta general o duda</option>
            <option value="Propuesta de colaboración">🤝 Colaboración o feedback</option>
          </select>
        </div>

        <div class="form-group">
          <label for="contact-message">Tu mensaje:</label>
          <textarea id="contact-message" name="message" rows="5" required placeholder="Cuéntanos en detalle tu sugerencia, duda o el fallo que encontraste..." class="form-input"></textarea>
        </div>

        <button type="submit" id="btn-submit" class="btn btn-primary btn-submit">
          <span class="btn-text">📨 Enviar mensaje</span>
        </button>
      </form>

      <!-- Mensaje de confirmación de éxito -->
      <div id="form-success" class="alert-box success hidden">
        <span class="alert-icon">🎉</span>
        <div>
          <h3>¡Mensaje enviado con éxito!</h3>
          <p>Hemos recibido tu mensaje y te responderemos a la brevedad posible a tu correo.</p>
          <button type="button" id="btn-send-another" class="btn btn-secondary btn-sm" style="margin-top: .6rem;">Enviar otro mensaje</button>
        </div>
      </div>

      <!-- Mensaje de error -->
      <div id="form-error" class="alert-box error hidden">
        <span class="alert-icon">⚠️</span>
        <div>
          <h3>No se pudo enviar el mensaje</h3>
          <p>Ocurrió un inconveniente al procesar el formulario. Puedes escribirnos directamente a: <a href="mailto:fff20252@gmail.com" class="error-mail">fff20252@gmail.com</a></p>
        </div>
      </div>
    </section>

    <!-- Información lateral directa -->
    <aside class="panel contact-info-card">
      <h3>Información de Contacto</h3>
      <p class="info-desc">Si prefieres no usar el formulario, puedes escribirnos directamente desde tu proveedor de correo habitual:</p>

      <div class="email-box">
        <label>Correo oficial:</label>
        <div class="email-copy-row">
          <input type="text" readonly value="fff20252@gmail.com" id="direct-email" class="email-input" />
          <button type="button" id="btn-copy-email" class="btn-copy" title="Copiar correo">
            <Icon name="copy" size={16} />
          </button>
        </div>
        <span id="copy-email-notice" class="copy-notice"></span>
      </div>

      <a href="mailto:fff20252@gmail.com?subject=Contacto%20desde%20UtiliaOnline" class="btn-open-mail">
        <Icon name="external-link" size={15} /> Abrir en tu app de correo
      </a>

      <hr class="divider" />

      <div class="info-item">
        <span class="info-icon">⏱️</span>
        <div>
          <strong>Tiempo estimado de respuesta</strong>
          <p>Normalmente respondemos en menos de 24 a 48 horas laborables.</p>
        </div>
      </div>

      <div class="info-item">
        <span class="info-icon">🔒</span>
        <div>
          <strong>Privacidad garantizada</strong>
          <p>Tu dirección de correo solo se usará para responder a tu mensaje. Nunca enviamos spam.</p>
        </div>
      </div>
    </aside>
  </div>
</Base>

<style>
  .breadcrumb{font-size:.85rem;color:var(--muted);margin-bottom:.5rem}.breadcrumb a{color:var(--muted)}
  .contact-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-top: 1.5rem;
  }
  @media (max-width: 820px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }

  .section-desc {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group label {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    color: var(--ink);
  }

  .form-input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    transition: border-color 0.15s ease;
  }
  .form-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .field-hint {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.3rem;
  }

  .btn-submit {
    padding: 0.75rem 1.4rem;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    background: var(--accent);
    color: var(--accent-ink);
    border: none;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.18s ease;
    margin-top: 0.5rem;
  }
  .btn-submit:hover:not(:disabled) {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
  .btn-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* Alertas de resultado */
  .alert-box {
    display: flex;
    gap: 1rem;
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius-sm);
    margin-top: 1rem;
    animation: fadeIn .25s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .alert-box.success {
    background: rgba(35, 134, 54, 0.12);
    border: 1px solid #2ea043;
    color: var(--ink);
  }
  .alert-box.success h3 {
    margin: 0 0 0.25rem 0;
    color: #3fb950;
    font-size: 1.05rem;
  }
  .alert-box.error {
    background: rgba(248, 81, 73, 0.12);
    border: 1px solid #f85149;
    color: var(--ink);
  }
  .alert-box.error h3 {
    margin: 0 0 0.25rem 0;
    color: #f85149;
    font-size: 1.05rem;
  }
  .alert-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }
  .error-mail {
    color: var(--accent);
    text-decoration: underline;
  }

  /* Tarjeta lateral */
  .contact-info-card h3 {
    margin-top: 0;
    font-size: 1.1rem;
  }
  .info-desc {
    color: var(--muted);
    font-size: 0.88rem;
    margin-bottom: 1.25rem;
    line-height: 1.45;
  }
  .email-box {
    margin-bottom: 1rem;
  }
  .email-box label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .email-copy-row {
    display: flex;
    gap: 0.4rem;
  }
  .email-input {
    flex: 1;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.75rem;
    font-family: monospace;
    font-size: 0.95rem;
    color: var(--ink);
    font-weight: 600;
  }
  .btn-copy {
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    border-radius: var(--radius-sm);
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .copy-notice {
    display: block;
    font-size: 0.78rem;
    color: #3fb950;
    margin-top: 0.3rem;
    min-height: 1rem;
    font-weight: 600;
  }
  .btn-open-mail {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    border-radius: var(--radius-sm);
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
    margin-bottom: 1.5rem;
  }
  .btn-open-mail:hover {
    background: var(--surface-hover);
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .divider {
    border: none;
    border-top: 1px solid var(--line);
    margin: 1.5rem 0;
  }

  .info-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }
  .info-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
  }
  .info-item strong {
    display: block;
    font-size: 0.88rem;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }
  .info-item p {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .hidden {
    display: none !important;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
  const formSuccess = document.getElementById('form-success')!;
  const formError = document.getElementById('form-error')!;
  const btnSendAnother = document.getElementById('btn-send-another') as HTMLButtonElement;
  const btnCopyEmail = document.getElementById('btn-copy-email') as HTMLButtonElement;
  const copyNotice = document.getElementById('copy-email-notice')!;
  const directEmail = (document.getElementById('direct-email') as HTMLInputElement).value;

  // Manejo del envío del formulario mediante FormSubmit AJAX
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    btnSubmit.disabled = true;
    btnSubmit.innerHTML = '<span>⏳ Enviando mensaje...</span>';
    formError.classList.add('hidden');

    const formData = new FormData(form);

    try {
      // Envío asíncrono a FormSubmit.co
      const response = await fetch('https://formsubmit.co/ajax/fff20252@gmail.com', {
        method: 'POST',
        headers: {
          'Accept': 'application/json'
        },
        body: formData
      });

      if (response.ok) {
        form.classList.add('hidden');
        formSuccess.classList.remove('hidden');
      } else {
        formError.classList.remove('hidden');
      }
    } catch (err) {
      formError.classList.remove('hidden');
    } finally {
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = '<span>📨 Enviar mensaje</span>';
    }
  });

  btnSendAnother?.addEventListener('click', () => {
    form.reset();
    formSuccess.classList.add('hidden');
    formError.classList.add('hidden');
    form.classList.remove('hidden');
  });

  // Copiar correo al portapapeles
  btnCopyEmail?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(directEmail);
      copyNotice.textContent = '✓ ¡Correo copiado!';
      setTimeout(() => {
        copyNotice.textContent = '';
      }, 2000);
    } catch {
      copyNotice.textContent = 'fff20252@gmail.com';
    }
  });
</script>

