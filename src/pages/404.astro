---
import Base from '../layouts/Base.astro';
---
<Base 
  title="Página no encontrada (404) · Herramientas Online" 
  description="La página que buscas no existe o ha sido movida."
>
  <div class="page-header" style="text-align: center; margin-block: 2rem 1.5rem;">
    <h1 style="font-size: 3.5rem; margin-bottom: 0.2rem;">404</h1>
    <p class="lead">La página o herramienta que buscas no existe o ha cambiado de enlace.</p>
  </div>

  <section class="panel" style="text-align: center; max-width: 550px; margin: 0 auto;">
    <p style="margin-bottom: 1.5rem; color: var(--muted);">Puedes regresar a la página principal para acceder a todas nuestras utilidades disponibles.</p>
    <a href="/" class="primary button" style="display: inline-block; padding: 0.65rem 1.4rem; text-decoration: none;">
      Volver al inicio
    </a>
  </section>
</Base>
