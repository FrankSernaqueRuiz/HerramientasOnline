---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Escalador de Recetas de Cocina – Ajustar Ingredientes y Porciones" description="Ajusta y multiplica fácilmente las cantidades de tus recetas al cambiar el número de porciones o comensales sin perder las proporciones.">
  <div class="page-header">
    <div class="breadcrumb"><a href="/">Herramientas</a> / <span>Hogar y vida diaria</span></div>
    <h1>Escalador de Recetas de Cocina</h1>
    <p class="lead">¿La receta es para 4 personas y tienes 10 invitados? Ajusta las proporciones exactas de cada ingrediente con un solo cambio.</p>
  </div>

  <section class="panel">
    <div class="servings-bar">
      <div class="servings-group">
        <label for="orig-servings">Porciones originales:</label>
        <input type="number" id="orig-servings" value="4" min="1" class="form-control-servings" />
      </div>
      <span class="arrow-sym">➔</span>
      <div class="servings-group">
        <label for="target-servings">Porciones deseadas:</label>
        <input type="number" id="target-servings" value="8" min="1" class="form-control-servings" />
      </div>
      <div class="factor-badge" id="factor-display">Multiplicador: x 2.0</div>
    </div>

    <div class="table-container">
      <table class="recipe-table">
        <thead>
          <tr>
            <th>Ingrediente</th>
            <th style="width:130px;">Cant. Original</th>
            <th style="width:140px;">Unidad</th>
            <th style="width:150px;" class="th-result">Cant. Escalada</th>
            <th style="width:40px;"></th>
          </tr>
        </thead>
        <tbody id="recipe-tbody">
          <!-- Rows -->
        </tbody>
      </table>
    </div>

    <div class="recipe-footer-actions">
      <button type="button" class="btn btn-secondary btn-sm" id="btn-add-ingredient">+ Agregar ingrediente</button>
      <div style="display:flex; gap:.75rem;">
        <button type="button" class="btn btn-primary btn-sm" id="btn-copy-recipe">📋 Copiar receta escalada</button>
        <button type="button" class="btn btn-secondary btn-sm" id="btn-reset-recipe">Vaciar lista</button>
      </div>
    </div>
  </section>
</Base>

<style>
  .breadcrumb{font-size:.85rem;color:var(--muted);margin-bottom:.5rem}.breadcrumb a{color:var(--muted)}
  .servings-bar{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;background:var(--surface-card);border:1px solid var(--line);border-radius:var(--radius-sm);padding:1.2rem;margin-bottom:1.5rem}
  .servings-group{display:flex;align-items:center;gap:.6rem}
  .servings-group label{font-weight:700;font-size:.9rem}
  .form-control-servings{width:75px;padding:.5rem .6rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font-size:1.1rem;font-weight:800;text-align:center}
  .arrow-sym{font-size:1.3rem;color:var(--muted)}
  .factor-badge{background:var(--accent);color:#fff;padding:.4rem .9rem;border-radius:2rem;font-weight:700;font-size:.88rem;margin-left:auto}
  @media(max-width:650px){.factor-badge{margin-left:0}}

  .table-container{overflow-x:auto;margin-bottom:1.2rem}
  .recipe-table{width:100%;border-collapse:collapse}
  .recipe-table th{background:var(--bg);padding:.6rem .6rem;font-size:.8rem;text-transform:uppercase;color:var(--muted);border-bottom:2px solid var(--line);text-align:left}
  :global(.recipe-table td){padding:.5rem .4rem;border-bottom:1px solid var(--line);vertical-align:middle}
  :global(.recipe-table input), :global(.recipe-table select){width:100%;padding:.45rem .6rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font:inherit}
  :global(.scaled-val-cell){font-weight:800;font-size:1.05rem;color:var(--accent);padding-left:.6rem}

  .recipe-footer-actions{display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;align-items:center}
  :global(.btn-del-ing){background:transparent;border:none;color:var(--muted);cursor:pointer;font-size:1.1rem;padding:.2rem}
  :global(.btn-del-ing:hover){color:#ef4444}
</style>

<script>
  interface Ingredient {
    name: string;
    qty: number;
    unit: string;
  }

  let ingredients: Ingredient[] = [
    { name: 'Harina de trigo', qty: 250, unit: 'gramos (g)' },
    { name: 'Azúcar blanca', qty: 150, unit: 'gramos (g)' },
    { name: 'Huevos', qty: 3, unit: 'unidades' },
    { name: 'Leche entera', qty: 200, unit: 'mililitros (ml)' },
    { name: 'Mantequilla derretida', qty: 80, unit: 'gramos (g)' },
    { name: 'Polvo de hornear / Levadura', qty: 1, unit: 'cucharadita' }
  ];

  const origInput = document.getElementById('orig-servings') as HTMLInputElement;
  const targetInput = document.getElementById('target-servings') as HTMLInputElement;
  const factorDisp = document.getElementById('factor-display')!;
  const tbody = document.getElementById('recipe-tbody')!;
  const btnAdd = document.getElementById('btn-add-ingredient')!;
  const btnCopy = document.getElementById('btn-copy-recipe')!;
  const btnReset = document.getElementById('btn-reset-recipe')!;

  const unitOptions = [
    'gramos (g)', 'kilogramos (kg)', 'mililitros (ml)', 'litros (L)',
    'tazas', 'cucharadas (cda)', 'cucharaditas (cdta)', 'unidades', 'pizcas', 'dientes', 'onzas (oz)'
  ];

  function render() {
    const orig = parseFloat(origInput.value) || 1;
    const target = parseFloat(targetInput.value) || 1;
    const factor = target / orig;

    factorDisp.textContent = `Multiplicador: x ${factor.toFixed(2)}`;

    tbody.innerHTML = '';
    ingredients.forEach((ing, idx) => {
      const scaled = (ing.qty * factor);
      const scaledFormatted = Number.isInteger(scaled) ? scaled.toString() : scaled.toFixed(scaled < 5 ? 2 : 1);

      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><input type="text" class="inp-name" value="${ing.name}" data-idx="${idx}" /></td>
        <td><input type="number" step="0.1" class="inp-qty" value="${ing.qty}" data-idx="${idx}" /></td>
        <td>
          <select class="inp-unit" data-idx="${idx}">
            ${unitOptions.map(u => `<option value="${u}" ${u === ing.unit ? 'selected' : ''}>${u}</option>`).join('')}
          </select>
        </td>
        <td class="scaled-val-cell">${scaledFormatted} ${ing.unit}</td>
        <td><button type="button" class="btn-del-ing" data-idx="${idx}" title="Eliminar">✕</button></td>
      `;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.inp-name').forEach(el => {
      el.addEventListener('input', (e) => {
        const i = parseInt((e.target as HTMLElement).dataset.idx || '0', 10);
        ingredients[i].name = (e.target as HTMLInputElement).value;
      });
    });

    tbody.querySelectorAll('.inp-qty').forEach(el => {
      el.addEventListener('input', (e) => {
        const i = parseInt((e.target as HTMLElement).dataset.idx || '0', 10);
        ingredients[i].qty = parseFloat((e.target as HTMLInputElement).value) || 0;
        render();
      });
    });

    tbody.querySelectorAll('.inp-unit').forEach(el => {
      el.addEventListener('change', (e) => {
        const i = parseInt((e.target as HTMLElement).dataset.idx || '0', 10);
        ingredients[i].unit = (e.target as HTMLSelectElement).value;
        render();
      });
    });

    tbody.querySelectorAll('.btn-del-ing').forEach(el => {
      el.addEventListener('click', (e) => {
        const i = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0', 10);
        ingredients.splice(i, 1);
        render();
      });
    });
  }

  origInput.addEventListener('input', render);
  targetInput.addEventListener('input', render);

  btnAdd.addEventListener('click', () => {
    ingredients.push({ name: '', qty: 100, unit: 'gramos (g)' });
    render();
  });

  btnReset.addEventListener('click', () => {
    ingredients = [];
    render();
  });

  btnCopy.addEventListener('click', () => {
    const orig = parseFloat(origInput.value) || 1;
    const target = parseFloat(targetInput.value) || 1;
    const factor = target / orig;

    let text = `RECETA ESCALADA PARA ${target} PORCIONES:\n\n`;
    ingredients.forEach(ing => {
      const scaled = (ing.qty * factor);
      const scaledFormatted = Number.isInteger(scaled) ? scaled.toString() : scaled.toFixed(1);
      text += `• ${ing.name || 'Ingrediente'}: ${scaledFormatted} ${ing.unit}\n`;
    });

    navigator.clipboard.writeText(text);
    btnCopy.textContent = '¡Receta copiada!';
    setTimeout(() => { btnCopy.textContent = '📋 Copiar receta escalada'; }, 2000);
  });

  render();
</script>
