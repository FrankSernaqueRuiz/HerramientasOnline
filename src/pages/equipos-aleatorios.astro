---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Generador de Equipos Aleatorios Online" description="Reparte una lista de nombres en equipos equilibrados de forma aleatoria e imparcial.">
  <div class="page-header">
    <div class="breadcrumb"><a href="/">Herramientas</a> / <span>Sorteos y diversión</span></div>
    <h1>Generador de Equipos Aleatorios</h1>
    <p class="lead">Pega los nombres, elige la cantidad de equipos y repártelos de forma pareja al instante.</p>
  </div>
  <section class="panel">
    <div class="eq-grid">
      <div>
        <label for="eq-names">Nombres (uno por línea):</label>
        <textarea id="eq-names" rows="10" placeholder="Ana&#10;Carlos&#10;María&#10;Pedro&#10;Lucía&#10;José&#10;Valeria&#10;Diego"></textarea>
        <div class="row-config">
          <div class="field-sm"><label for="eq-count">Nº de equipos:</label><input type="number" id="eq-count" min="2" max="20" value="2" /></div>
          <button type="button" id="btn-gen-eq" class="btn-primary"><Icon name="refresh" size={16}/> Generar equipos</button>
        </div>
      </div>
      <div id="eq-results" class="eq-results"><p class="placeholder">Los equipos aparecerán aquí</p></div>
    </div>
  </section>
</Base>
<style>
  .breadcrumb{font-size:.85rem;color:var(--muted);margin-bottom:.5rem}.breadcrumb a{color:var(--muted)}
  .eq-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}@media(max-width:768px){.eq-grid{grid-template-columns:1fr}}
  label{display:block;font-weight:600;font-size:.9rem;margin-bottom:.4rem}
  .row-config{display:flex;gap:1rem;align-items:end;margin-top:1rem;flex-wrap:wrap}
  .field-sm input[type="number"]{width:70px;padding:.5rem;background:var(--bg);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--ink);font:inherit}
  .btn-primary{background:var(--accent);color:var(--accent-ink);border:none;border-radius:var(--radius-sm);padding:.65rem 1.2rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:.4rem}
  .eq-results{display:flex;flex-direction:column;gap:.85rem}
  .placeholder{color:var(--muted);text-align:center;padding:3rem 0}
  :global(.team-card){background:var(--surface-card);border:1px solid var(--line);border-radius:var(--radius-sm);padding:1rem;animation:fadeSlide .4s ease both}
  :global(.team-card h3){margin:0 0 .5rem;font-size:1rem;display:flex;align-items:center;gap:.5rem}
  :global(.team-card .dot){width:12px;height:12px;border-radius:50%;display:inline-block}
  :global(.team-member){padding:.3rem 0;font-size:.92rem;border-bottom:1px solid var(--line)}
  :global(.team-member:last-child){border:none}
  @keyframes fadeSlide{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
</style>
<script>
  const COLORS=['#e74c3c','#3498db','#2ecc71','#f39c12','#9b59b6','#1abc9c','#e67e22','#e84393'];
  const ta=document.getElementById('eq-names') as HTMLTextAreaElement;
  const countInput=document.getElementById('eq-count') as HTMLInputElement;
  const btn=document.getElementById('btn-gen-eq')!;
  const results=document.getElementById('eq-results')!;

  btn.addEventListener('click',()=>{
    const names=ta.value.split('\n').map(s=>s.trim()).filter(Boolean);
    const n=Math.min(parseInt(countInput.value)||2,names.length);
    if(names.length<2)return;
    for(let i=names.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[names[i],names[j]]=[names[j],names[i]]}
    const teams:string[][]=Array.from({length:n},()=>[]);
    names.forEach((name,i)=>teams[i%n].push(name));
    results.innerHTML='';
    teams.forEach((team,i)=>{
      const card=document.createElement('div');card.className='team-card';card.style.animationDelay=`${i*.1}s`;
      card.innerHTML=`<h3><span class="dot" style="background:${COLORS[i%COLORS.length]}"></span>Equipo ${i+1} (${team.length})</h3>${team.map(m=>`<div class="team-member">${m}</div>`).join('')}`;
      results.appendChild(card);
    });
  });
</script>
